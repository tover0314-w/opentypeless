+            }
+            """,
+            encoding="utf-8",
+        )
+        rules = self.rules()
+        self.assertIn("EDITOR_WRITE_OUTSIDE_ETM", rules)
+
+    def test_hidden_compiled_branch_is_still_a_writer_violation(self) -> None:
