+package com.opentypeless.routea.safety
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertIs
+
+class SafetyInputEventDispatcherTest {
+    @Test
+    fun matchingDownUpDispatchesExactlyOnce() {
+        val received = mutableListOf<SafetyShellIntent>()
+        val dispatcher = SafetyInputEventDispatcher { intent ->
+            received += intent
+            SafetyDispatchResult.Accepted
+        }
+        val intent = SafetyShellIntent.Text("a")
+
+        assertIs<SafetyDispatchResult.Accepted>(dispatcher.sendDown(intent))
+        assertEquals(emptyList(), received)
+        assertIs<SafetyDispatchResult.Accepted>(dispatcher.sendUp(intent))
+        assertEquals(listOf<SafetyShellIntent>(intent), received)
+    }
+
+    @Test
+    fun overlappingMismatchAndCancelFailClosedWithoutDispatch() {
+        var calls = 0
+        val dispatcher = SafetyInputEventDispatcher {
+            calls += 1
+            SafetyDispatchResult.Accepted
+        }
+        val first = SafetyShellIntent.Text("a")
+        val second = SafetyShellIntent.Text("b")
+
+        assertIs<SafetyDispatchResult.Accepted>(dispatcher.sendDown(first))
+        assertEquals(
+            SafetyDispatchResult.Rejected(SafetyRejectionReason.INPUT_ALREADY_ACTIVE),
+            dispatcher.sendDown(second),
+        )
+        assertEquals(
+            SafetyDispatchResult.Rejected(SafetyRejectionReason.INPUT_SEQUENCE_MISMATCH),
+            dispatcher.sendUp(second),
+        )
+        assertEquals(0, calls)
+
+        assertIs<SafetyDispatchResult.Accepted>(dispatcher.sendDown(first))
+        assertIs<SafetyDispatchResult.Accepted>(dispatcher.sendCancel(first))
+        assertEquals(0, calls)
+    }
+
+    @Test
+    fun throwingReceiverCannotLeaveAnActiveOrFallbackInput() {
+        var calls = 0
+        val dispatcher = SafetyInputEventDispatcher { intent ->
+            calls += 1
+            if (intent == SafetyShellIntent.Text("boom")) error("expected")
+            SafetyDispatchResult.Accepted
+        }
+
+        assertFailsWith<IllegalStateException> {
+            dispatcher.sendDownUp(SafetyShellIntent.Text("boom"))
+        }
+        assertEquals(1, calls)
+        assertIs<SafetyDispatchResult.Accepted>(
+            dispatcher.sendDownUp(SafetyShellIntent.Text("ok")),
+        )
+        assertEquals(2, calls)
+    }
+
+    @Test
+    fun closeRevokesPendingAndFutureInput() {
+        var calls = 0
+        val dispatcher = SafetyInputEventDispatcher {
+            calls += 1
+            SafetyDispatchResult.Accepted
+        }
+        val intent = SafetyShellIntent.Space
+
+        assertIs<SafetyDispatchResult.Accepted>(dispatcher.sendDown(intent))
+        dispatcher.close()
+        assertEquals(
+            SafetyDispatchResult.Rejected(SafetyRejectionReason.DISPATCHER_CLOSED),
+            dispatcher.sendUp(intent),
+        )
+        assertEquals(
+            SafetyDispatchResult.Rejected(SafetyRejectionReason.DISPATCHER_CLOSED),
+            dispatcher.sendDownUp(intent),
+        )
+        assertEquals(0, calls)
+    }
+}
