+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+
+"""Fail-closed source/merged manifest gate for the Route-A safety evaluation."""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+import sys
+import xml.etree.ElementTree as ET
+
+
+ANDROID_NAMESPACE = "http://schemas.android.com/apk/res/android"
+ANDROID = f"{{{ANDROID_NAMESPACE}}}"
+EXPECTED_IME_SERVICE = "com.opentypeless.routea.safety.SafetyEvalImeService"
+EXPECTED_IME_PERMISSION = "android.permission.BIND_INPUT_METHOD"
+EXPECTED_IME_ACTION = "android.view.InputMethod"
+EXPECTED_IME_METADATA = "android.view.im"
+EXPECTED_PACKAGE_NAMES = frozenset(
+    {
+        "com.opentypeless.routea.safetyeval",
+        "com.opentypeless.routea.safetyeval.debug",
+    }
+)
+
+BASE_BACKUP_DOMAINS = frozenset(
+    {"root", "file", "database", "sharedpref", "external"}
+)
+DATA_EXTRACTION_DOMAINS = BASE_BACKUP_DOMAINS | frozenset(
+    {"device_root", "device_file", "device_database", "device_sharedpref"}
+)
+
+
+class PolicyError(ValueError):
+    """A source or merged manifest violates the Route-A safety policy."""
+
+
+def _android(name: str) -> str:
+    return ANDROID + name
+
+
+def _local_name(tag: str) -> str:
+    return tag.rsplit("}", 1)[-1]
+
+
+def _parse(text: str, label: str) -> ET.Element:
+    try:
+        return ET.fromstring(text)
+    except ET.ParseError as error:
+        raise PolicyError(f"{label}: malformed XML: {error}") from error
+
+
+def _require(condition: bool, message: str) -> None:
+    if not condition:
+        raise PolicyError(message)
+
+
+def verify_manifest_text(text: str, label: str = "manifest") -> None:
+    root = _parse(text, label)
+    _require(_local_name(root.tag) == "manifest", f"{label}: root must be manifest")
+
+    package_name = root.get("package")
+    if package_name is None:
+        manifest_variant = "source"
+        expected_root_attributes: dict[str, str] = {}
+    else:
+        _require(
+            package_name in EXPECTED_PACKAGE_NAMES,
+            f"{label}: unexpected package name",
+        )
+        manifest_variant = "debug" if package_name.endswith(".debug") else "release"
+        expected_root_attributes = {
+            "package": package_name,
+            _android("versionCode"): "1",
+            _android("versionName"): "0.1-ksp009-safety",
+        }
+    _require(
+        root.attrib == expected_root_attributes,
+        f"{label}: manifest attributes do not match the {manifest_variant} variant",
+    )
+
+    top_level = [_local_name(child.tag) for child in root]
+    unknown_top_level = sorted(set(top_level) - {"uses-sdk", "application"})
+    _require(
+        not unknown_top_level,
+        f"{label}: forbidden top-level nodes: {', '.join(unknown_top_level)}",
+    )
+    _require(top_level.count("application") == 1, f"{label}: require one application")
+    _require(top_level.count("uses-sdk") <= 1, f"{label}: at most one uses-sdk")
+
+    uses_sdk = next(
+        (child for child in root if _local_name(child.tag) == "uses-sdk"),
+        None,
+    )
+    if manifest_variant == "source":
+        _require(uses_sdk is None, f"{label}: source manifest must not declare uses-sdk")
+    else:
+        _require(uses_sdk is not None, f"{label}: merged manifest requires uses-sdk")
+        _require(
+            uses_sdk is not None
+            and
+            uses_sdk.attrib
+            == {
+                _android("minSdkVersion"): "26",
+                _android("targetSdkVersion"): "36",
+            },
+            f"{label}: uses-sdk attributes do not match the fixed variant",
+        )
+        _require(not list(uses_sdk), f"{label}: uses-sdk children are forbidden")
+
+    application = next(child for child in root if _local_name(child.tag) == "application")
+    _require(
+        application.get(_android("allowBackup")) == "false",
+        f"{label}: allowBackup must be false",
+    )
+    _require(
+        application.get(_android("fullBackupContent")) == "@xml/backup_rules",
+        f"{label}: fullBackupContent must reference @xml/backup_rules",
+    )
+    _require(
+        application.get(_android("dataExtractionRules")) == "@xml/data_extraction_rules",
+        f"{label}: dataExtractionRules must reference @xml/data_extraction_rules",
+    )
+    source_application_attributes = {
+        _android("allowBackup"): "false",
+        _android("dataExtractionRules"): "@xml/data_extraction_rules",
+        _android("fullBackupContent"): "@xml/backup_rules",
+        _android("label"): "@string/route_a_safety_ime_name",
+        _android("supportsRtl"): "true",
+    }
+    release_application_attributes = source_application_attributes | {
+        _android("extractNativeLibs"): "false",
+    }
+    debug_application_attributes = release_application_attributes | {
+        _android("debuggable"): "true",
+    }
+    expected_application_attributes = {
+        "source": source_application_attributes,
+        "release": release_application_attributes,
+        "debug": debug_application_attributes,
+    }[manifest_variant]
+    _require(
+        application.attrib == expected_application_attributes,
+        f"{label}: application attributes do not match the {manifest_variant} variant",
+    )
+
+    application_children = list(application)
+    _require(
+        len(application_children) == 1
+        and _local_name(application_children[0].tag) == "service",
+        f"{label}: application must contain only the safety IME service",
+    )
+    service = application_children[0]
+    _require(
+        service.get(_android("name")) == EXPECTED_IME_SERVICE,
+        f"{label}: unexpected IME service",
+    )
+    _require(
+        service.get(_android("exported")) == "true",
+        f"{label}: safety IME must be exported",
+    )
+    _require(
+        service.get(_android("permission")) == EXPECTED_IME_PERMISSION,
+        f"{label}: safety IME must require BIND_INPUT_METHOD",
+    )
+    allowed_service_attributes = {
+        _android("name"),
+        _android("exported"),
+        _android("label"),
+        _android("permission"),
+    }
+    _require(
+        set(service.attrib).issubset(allowed_service_attributes),
+        f"{label}: safety IME contains an unknown attribute",
+    )
+
+    service_children = list(service)
+    _require(
+        [_local_name(child.tag) for child in service_children].count("intent-filter") == 1,
+        f"{label}: safety IME requires one intent-filter",
+    )
+    _require(
+        [_local_name(child.tag) for child in service_children].count("meta-data") == 1,
+        f"{label}: safety IME requires one metadata node",
+    )
+    _require(
+        len(service_children) == 2,
+        f"{label}: safety IME contains an unknown child",
+    )
+
+    intent_filter = next(
+        child for child in service_children if _local_name(child.tag) == "intent-filter"
+    )
+    _require(not intent_filter.attrib, f"{label}: IME intent-filter attributes are forbidden")
+    filter_children = list(intent_filter)
+    _require(
+        len(filter_children) == 1
+        and _local_name(filter_children[0].tag) == "action"
+        and filter_children[0].get(_android("name")) == EXPECTED_IME_ACTION,
+        f"{label}: safety IME filter must contain only android.view.InputMethod",
+    )
+    action = filter_children[0]
+    _require(not list(action), f"{label}: IME action children are forbidden")
+    _require(
+        set(action.attrib) == {_android("name")},
+        f"{label}: IME action contains an unknown attribute",
+    )
+
+    metadata = next(
+        child for child in service_children if _local_name(child.tag) == "meta-data"
+    )
+    _require(
+        metadata.get(_android("name")) == EXPECTED_IME_METADATA
+        and metadata.get(_android("resource")) == "@xml/method",
+        f"{label}: safety IME metadata must reference @xml/method",
+    )
+    _require(not list(metadata), f"{label}: IME metadata children are forbidden")
+    _require(
+        set(metadata.attrib) == {_android("name"), _android("resource")},
+        f"{label}: IME metadata contains an unknown attribute",
+    )
+
+
+def _verify_excludes(
+    parent: ET.Element,
+    expected_domains: frozenset[str],
+    label: str,
+) -> None:
+    children = list(parent)
+    _require(children, f"{label}: exclusion set must not be empty")
+    _require(
+        all(_local_name(child.tag) == "exclude" for child in children),
+        f"{label}: only exclude nodes are allowed",
+    )
+    domains = [child.get("domain") for child in children]
+    _require(None not in domains, f"{label}: every exclude requires a domain")
+    _require(len(domains) == len(set(domains)), f"{label}: duplicate domain")
+    _require(
+        frozenset(domains) == expected_domains,
+        f"{label}: domain set mismatch",
+    )
+    _require(
+        all(child.get("path") == "." for child in children),
+        f"{label}: every exclusion path must be '.'",
+    )
+    _require(
+        all(set(child.attrib) == {"domain", "path"} for child in children),
+        f"{label}: exclude nodes contain unknown attributes",
+    )
+    _require(
+        all(not list(child) for child in children),
+        f"{label}: exclude nodes must be empty",
+    )
+
+
+def verify_backup_rules_text(text: str, label: str = "backup rules") -> None:
+    root = _parse(text, label)
+    _require(
+        _local_name(root.tag) == "full-backup-content",
+        f"{label}: root must be full-backup-content",
+    )
+    _require(not root.attrib, f"{label}: root attributes are not allowed")
+    _verify_excludes(root, BASE_BACKUP_DOMAINS, label)
+
+
+def verify_data_extraction_rules_text(
+    text: str,
+    label: str = "data extraction rules",
+) -> None:
+    root = _parse(text, label)
+    _require(
+        _local_name(root.tag) == "data-extraction-rules",
+        f"{label}: root must be data-extraction-rules",
+    )
+    _require(not root.attrib, f"{label}: root attributes are not allowed")
+    sections = list(root)
+    section_names = [_local_name(section.tag) for section in sections]
+    _require(
+        len(sections) == 2
+        and section_names.count("cloud-backup") == 1
+        and section_names.count("device-transfer") == 1,
+        f"{label}: require one cloud-backup and one device-transfer section",
+    )
+    for section in sections:
+        name = _local_name(section.tag)
+        _require(not section.attrib, f"{label}/{name}: attributes are not allowed")
+        _verify_excludes(section, DATA_EXTRACTION_DOMAINS, f"{label}/{name}")
+
+
+def verify_method_text(text: str, label: str = "IME method") -> None:
+    root = _parse(text, label)
+    _require(_local_name(root.tag) == "input-method", f"{label}: root must be input-method")
+    _require(
+        set(root.attrib) == {_android("supportsSwitchingToNextInputMethod")}
+        and root.get(_android("supportsSwitchingToNextInputMethod")) == "true",
+        f"{label}: only next-input-method switching may be declared",
+    )
+    children = list(root)
+    _require(
+        len(children) == 1 and _local_name(children[0].tag) == "subtype",
+        f"{label}: require one subtype",
+    )
+    subtype = children[0]
+    _require(not list(subtype), f"{label}: subtype children are forbidden")
+    _require(
+        subtype.get(_android("imeSubtypeMode")) == "keyboard",
+        f"{label}: subtype mode must be keyboard",
+    )
+    _require(
+        subtype.get(_android("isAsciiCapable")) == "true",
+        f"{label}: subtype must be ASCII capable",
+    )
+    _require(
+        subtype.get(_android("overridesImplicitlyEnabledSubtype")) == "true",
+        f"{label}: subtype must override the implicit subtype",
+    )
+    _require(
+        subtype.get(_android("label")) == "@string/route_a_safety_ime_name",
+        f"{label}: subtype must use the safety evaluation label",
+    )
+    _require(
+        set(subtype.attrib)
+        == {
+            _android("imeSubtypeMode"),
+            _android("isAsciiCapable"),
+            _android("label"),
+            _android("overridesImplicitlyEnabledSubtype"),
+        },
+        f"{label}: subtype contains an unknown attribute",
+    )
+
+
+def verify_files(
+    manifest: Path,
+    method: Path,
+    backup_rules: Path,
+    data_extraction_rules: Path,
+) -> None:
+    verify_manifest_text(manifest.read_text(encoding="utf-8"), str(manifest))
+    verify_method_text(method.read_text(encoding="utf-8"), str(method))
+    verify_backup_rules_text(backup_rules.read_text(encoding="utf-8"), str(backup_rules))
+    verify_data_extraction_rules_text(
+        data_extraction_rules.read_text(encoding="utf-8"),
+        str(data_extraction_rules),
+    )
+
+
+def _parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--manifest", required=True, type=Path)
+    parser.add_argument("--method", required=True, type=Path)
+    parser.add_argument("--backup-rules", required=True, type=Path)
+    parser.add_argument("--data-extraction-rules", required=True, type=Path)
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = _parser().parse_args(argv)
+    try:
+        verify_files(
+            args.manifest,
+            args.method,
+            args.backup_rules,
+            args.data_extraction_rules,
+        )
+    except (OSError, PolicyError) as error:
+        print(f"FAIL: {error}", file=sys.stderr)
+        return 1
+    print("PASS: Route-A safety manifest and no-backup rules")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
