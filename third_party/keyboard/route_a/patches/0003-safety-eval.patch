+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import tempfile
+import unittest
+from pathlib import Path
+
+import verify_route_a_safety_architecture as verifier
+
+
+ETM = verifier.EDITOR_TRANSACTION_MANAGER
+IC = verifier.INPUT_CONNECTION
+
+
+def valid_dexdump() -> str:
+    invoke_descriptor = verifier.INVOKE_MUTATOR_DESCRIPTOR
+    return f"""
+CLASS Lcom/opentypeless/routea/safety/SafeShellProducer;
+METHOD emit(Lcom/opentypeless/android/editor/EditorOperation;)V
+INVOKE_INTERFACE Lcom/opentypeless/routea/safety/ShellEventSink; dispatch (Lcom/opentypeless/android/editor/EditorOperation;)V
+
+CLASS {ETM}
+METHOD beginBatch(Landroid/view/inputmethod/InputConnection;)Z
+INVOKE_INTERFACE {IC} beginBatchEdit ()Z
+METHOD finishBatch(Landroid/view/inputmethod/InputConnection;)V
+INVOKE_INTERFACE {IC} endBatchEdit ()Z
+METHOD invokeMutator{invoke_descriptor}
+INVOKE_INTERFACE {IC} commitText (Ljava/lang/CharSequence;I)Z
+INVOKE_INTERFACE {IC} deleteSurroundingTextInCodePoints (II)Z
+INVOKE_INTERFACE {IC} setComposingText (Ljava/lang/CharSequence;I)Z
+INVOKE_INTERFACE {IC} finishComposingText ()Z
+INVOKE_INTERFACE {IC} performEditorAction (I)Z
+""".strip()
+
+
+class SafetyArchitectureVerifierTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.temp = tempfile.TemporaryDirectory()
+        self.root = Path(self.temp.name)
+        (self.root / "build.gradle.kts").write_text(
+            'plugins { id("com.android.library") }\n'
+            'dependencies {\n'
+            'implementation(project(":opentypeless-editor-host"))\n'
+            'implementation(libs.kotlinx.coroutines)\n'
+            'testImplementation(libs.kotlin.test.junit5)\n'
+            'androidTestImplementation(libs.androidx.test.ext)\n'
+            'androidTestImplementation(libs.androidx.test.espresso.core)\n'
+            'androidTestImplementation("androidx.annotation:annotation:1.8.1")\n'
+            '}\n',
+            encoding="utf-8",
+        )
+        for relative in verifier.EXPECTED_PRODUCTION_SOURCE_PATHS:
+            path = self.root / relative
+            path.parent.mkdir(parents=True, exist_ok=True)
+            if relative.endswith("RimeAdapter.java"):
+                contents = (
+                    "package com.opentypeless.ksp004;\n"
+                    "public final class RimeAdapter {}\n"
+                )
+            else:
+                contents = (
+                    "package com.opentypeless.routea.safety\n"
+                    f"internal class {path.stem}\n"
+                )
+            path.write_text(contents, encoding="utf-8")
+        self.producer_source = self.root / (
+            "src/main/kotlin/com/opentypeless/routea/safety/SafetyShellIntent.kt"
+        )
+        self.debug = self.root / "debug.dexdump.txt"
+        self.release = self.root / "release.dexdump.txt"
+        self.debug.write_text(valid_dexdump(), encoding="utf-8")
+        self.release.write_text(valid_dexdump(), encoding="utf-8")
+
+    def tearDown(self) -> None:
+        self.temp.cleanup()
+
+    def rules(self) -> set[str]:
+        return {
+            violation.rule
+            for violation in verifier.verify(self.root, self.debug, self.release)
+        }
+
+    def test_valid_source_and_both_compiled_variants_pass(self) -> None:
+        self.assertEqual((), verifier.verify(self.root, self.debug, self.release))
+
+    def test_producer_prefix_override_is_honored_by_both_gates(self) -> None:
+        override = "org.example.routea"
+        for relative in verifier.EXPECTED_PRODUCTION_SOURCE_PATHS:
+            if relative.endswith("RimeAdapter.java"):
+                continue
+            source = self.root / relative
+            source.write_text(
+                f"package {override}\ninternal class {source.stem}\n",
+                encoding="utf-8",
+            )
+        overridden = valid_dexdump().replace(
+            "Lcom/opentypeless/routea/safety/", "Lorg/example/routea/"
+        )
+        self.debug.write_text(overridden, encoding="utf-8")
+        self.release.write_text(overridden, encoding="utf-8")
+        self.assertEqual(
+            (),
+            verifier.verify(
+                self.root,
+                self.debug,
+                self.release,
+                producer_prefix=override,
+            ),
+        )
+
+    def test_safety_module_may_not_depend_on_app(self) -> None:
+        (self.root / "build.gradle.kts").write_text(
+            'dependencies { implementation(project(":app")) }\n', encoding="utf-8"
+        )
+        self.assertIn("SAFETY_MODULE_APP_DEPENDENCY", self.rules())
+
+    def test_safety_module_dependency_declarations_are_exact(self) -> None:
