+ */
+
+package com.opentypeless.routea.safety
+
+import android.view.View
+import android.view.inputmethod.EditorInfo
+import android.widget.TextView
+import com.opentypeless.android.editor.host.EditorAuthorityInputMethodService
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+
+/** Buildable evaluation IME whose Shell receives only the capability-free EditorPort. */
+class SafetyEvalImeService : EditorAuthorityInputMethodService() {
+    private var session: SafetySession? = null
+
+    override fun onCreateInputView(): View =
+        session?.view ?: TextView(this).apply {
+            text = getString(R.string.status_ready)
+            contentDescription = getString(R.string.status_ready)
+        }
+
+    override fun onEditorInputStarted(
+        editorInfo: EditorInfo,
+        restarting: Boolean,
+        generation: Long,
+    ) {
+        session?.close()
+        session = if (editorPort().allowsKeyboardProcessing()) {
+            createPlaintextSession(generation)
+        } else {
+            createFailClosedSession(generation)
+        }
+        setInputView(session?.view)
+    }
+
+    override fun onEditorInputFinishing() {
+        session?.close()
+        session = null
+    }
+
+    override fun onEditorAuthorityDestroying() {
+        session?.close()
+        session = null
+    }
+
+    private fun createPlaintextSession(generation: Long): SafetySession {
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+        lateinit var sink: PortSafetyEditorSink
+        lateinit var view: SafetyTextKeyboardView
+        val controller = if (editorPort().allowsRimeProcessing()) {
+            SafetyRimeController(
+                context = applicationContext,
+                editorGeneration = generation,
+                parentScope = scope,
+                onOutput = { output -> sink.onRimeOutput(output) },
+            )
+        } else {
+            null
+        }
+        val observer = object : SafetyRimeUiObserver {
+            override fun onComposition(preedit: String, candidates: List<String>) {
+                view.onComposition(preedit, candidates)
+            }
+
+            override fun onTerminal(result: SafetyDispatchResult) {
+                view.onTerminal(result)
+            }
+
+            override fun onFailure(kind: SafetyRimeFailureKind) {
+                view.onFailure(kind)
+            }
+        }
+        sink = PortSafetyEditorSink(editorPort(), generation, controller, observer)
+        val route = ExclusiveWriterRoute.bindForSession(
+            sessionId = generation,
+            selectedRoute = SafetyWriterRoute.SAFETY,
+            safetySink = sink,
+            legacyFakeSink = null,
+        )
+        val dispatcher = SafetyShellRouter(route).newInputEventDispatcher()
+        view = SafetyTextKeyboardView(this, generation, dispatcher)
+        return SafetySession(view, dispatcher, sink, scope)
+    }
+
+    private fun createFailClosedSession(generation: Long): SafetySession {
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+        val rejecting = SafetyEditorSink {
+            SafetyDispatchResult.Rejected(SafetyRejectionReason.POLICY_DENIED)
+        }
+        val route = ExclusiveWriterRoute.bindForSession(
+            sessionId = generation,
+            selectedRoute = SafetyWriterRoute.SAFETY,
+            safetySink = rejecting,
+            legacyFakeSink = null,
+        )
+        val dispatcher = SafetyShellRouter(route).newInputEventDispatcher()
+        val view = SafetyTextKeyboardView(this, generation, dispatcher)
+        return SafetySession(view, dispatcher, null, scope)
+    }
+
+    private class SafetySession(
+        val view: SafetyTextKeyboardView,
+        private val dispatcher: SafetyInputEventDispatcher,
+        private val sink: PortSafetyEditorSink?,
+        private val scope: CoroutineScope,
+    ) : AutoCloseable {
+        override fun close() {
+            view.close()
+            dispatcher.close()
+            sink?.close()
+            scope.cancel()
+        }
+    }
+}
