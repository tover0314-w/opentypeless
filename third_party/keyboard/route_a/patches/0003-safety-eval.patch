+
+@DisableCachingByDefault(because = "Runs the pinned Android SDK dexdump tool over a final APK")
+abstract class GenerateRouteASafetyDexdumpTask @Inject constructor(
+    private val execOperations: ExecOperations,
+) : DefaultTask() {
+    @get:InputDirectory
+    @get:PathSensitive(PathSensitivity.RELATIVE)
+    abstract val apkDirectory: DirectoryProperty
+
+    @get:InputFile
+    @get:PathSensitive(PathSensitivity.NONE)
+    abstract val dexdumpExecutable: RegularFileProperty
+
+    @get:OutputFile
+    abstract val outputFile: RegularFileProperty
+
+    @TaskAction
+    fun generate() {
+        val apkRoot = apkDirectory.get().asFile
+        val apkFiles = apkRoot
+            .walkTopDown()
+            .filter { it.isFile && it.extension == "apk" }
+            .sortedBy { it.relativeTo(apkRoot).invariantSeparatorsPath }
+            .toList()
+        if (apkFiles.size != 1) {
+            throw GradleException(
+                "Route-A safety gate requires exactly one final APK, found ${apkFiles.size}",
+            )
+        }
+        val apkFile = apkFiles.single()
+        if (apkFile.length() == 0L) {
+            throw GradleException("Route-A safety gate refuses an empty APK: $apkFile")
+        }
+
+        val dexDirectory = temporaryDir.resolve("final-apk-dex")
+        if (dexDirectory.exists() && !dexDirectory.deleteRecursively()) {
+            throw GradleException("Cannot clear Route-A safety dex workspace: $dexDirectory")
+        }
+        if (!dexDirectory.mkdirs()) {
+            throw GradleException("Cannot create Route-A safety dex workspace: $dexDirectory")
+        }
+
+        val dexName = Regex("classes(?:[2-9]|[1-9][0-9]+)?\\.dex")
+        val dexFiles = ZipFile(apkFile).use { archive ->
+            val entries = archive.entries().asSequence()
+                .filter { !it.isDirectory && dexName.matches(it.name) }
+                .sortedBy { entry ->
+                    entry.name.removePrefix("classes").removeSuffix(".dex").toIntOrNull() ?: 1
+                }
+                .toList()
+            if (entries.isEmpty()) {
+                throw GradleException("Route-A safety APK contains no root classes*.dex: $apkFile")
+            }
+            if (entries.map { it.name }.toSet().size != entries.size) {
+                throw GradleException("Route-A safety APK contains duplicate classes*.dex entries")
+            }
+            entries.map { entry ->
+                val destination = dexDirectory.resolve(entry.name)
+                archive.getInputStream(entry).use { input ->
+                    destination.outputStream().use { output -> input.copyTo(output) }
+                }
+                if (destination.length() == 0L) {
+                    throw GradleException("Route-A safety APK contains an empty dex: ${entry.name}")
+                }
+                destination
+            }
+        }
+
+        val report = outputFile.get().asFile
+        if (!report.parentFile.isDirectory && !report.parentFile.mkdirs()) {
+            throw GradleException("Cannot create Route-A safety report directory: ${report.parentFile}")
+        }
+        FileOutputStream(report, false).use { output ->
+            execOperations.exec {
+                executable(dexdumpExecutable.get().asFile)
+                args("-d")
+                args(dexFiles.map { it.absolutePath })
+                standardOutput = output
+            }.assertNormalExitValue()
+        }
+        if (!report.isFile || report.length() == 0L) {
+            throw GradleException("Route-A safety gate refuses empty dexdump output: $report")
+        }
+    }
+}
