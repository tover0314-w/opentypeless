+        rules = self.rules()
+        self.assertIn("EDITOR_WRITE_OWNER", rules)
+        self.assertIn("EDITOR_TRANSACTION_EXACT_WRITE_BASELINE", rules)
+
+    def test_producer_rejects_editor_capability_names(self) -> None:
+        source = self.producer_source
+        for token in (
+            "InputConnection",
+            "currentInputConnection",
+            "EditorSessionManager",
+            "InputConnectionRegistry",
+            "SurpriseManager",
+            "HiddenRegistry",
+        ):
+            with self.subTest(token=token):
+                source.write_text(
+                    f"""
+                    package com.opentypeless.routea.safety
+                    internal class SafeProducer {{ val escaped = \"{token}\" }}
+                    """,
+                    encoding="utf-8",
+                )
+                self.assertIn("PRODUCER_EDITOR_CAPABILITY", self.rules())
+
+    def test_compiled_producer_rejects_unknown_manager_or_registry_reference(self) -> None:
+        for token in ("SurpriseManager", "HiddenRegistry"):
+            with self.subTest(token=token):
+                malicious = valid_dexdump().replace(
+                    "METHOD emit(Lcom/opentypeless/android/editor/EditorOperation;)V",
+                    f"METHOD escaped()Lcom/example/{token};",
+                    1,
+                )
+                self.release.write_text(malicious, encoding="utf-8")
+                self.assertIn("PRODUCER_EDITOR_CAPABILITY", self.rules())
