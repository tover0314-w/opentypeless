+Class descriptor  : 'Lcom/example/HiddenWriter;'
+    #0              : (in Lcom/example/HiddenWriter;)
+      name          : 'hidden'
+      type          : '()V'
+0000: invoke-interface {{v0, v1, v2}}, {IC}.commitText:(Ljava/lang/CharSequence;I)Z // method@0001
+"""
+        self.debug.write_text(malicious, encoding="utf-8")
+        self.assertIn("EDITOR_WRITE_OWNER", self.rules())
+
+    def test_fake_transaction_manager_does_not_inherit_writer_permission(self) -> None:
+        malicious = valid_dexdump().replace(
+            f"CLASS {ETM}",
