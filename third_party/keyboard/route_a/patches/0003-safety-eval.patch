+
+class SafetyQuickActionTest {
+    @Test
+    fun insertKeyVocabularyContainsOnlyVoiceAndUndo() {
+        val received = mutableListOf<SafetyShellIntent>()
+        val dispatcher = dispatcher(received)
+
+        SafetyShellIntent.QuickActionKey.entries.forEach { key ->
+            assertIs<SafetyDispatchResult.Accepted>(
+                SafetyQuickAction.InsertKey(key).dispatch(
+                    dispatcher,
+                    editorGeneration = 12L,
+                ),
+            )
+        }
+        assertEquals(
+            listOf<SafetyShellIntent>(
+                SafetyShellIntent.Voice(12L),
+                SafetyShellIntent.Undo(12L),
+            ),
+            received,
+        )
+    }
+
+    @Test
+    fun insertTextPreservesActionIdentityAndBoundedGeneration() {
+        val received = mutableListOf<SafetyShellIntent>()
+        val dispatcher = dispatcher(received)
+
+        assertIs<SafetyDispatchResult.Accepted>(
+            SafetyQuickAction.InsertText("!").dispatch(dispatcher, editorGeneration = 13L),
+        )
+        assertEquals(
+            listOf<SafetyShellIntent>(SafetyShellIntent.QuickActionInsertText("!", 13L)),
+            received,
+        )
+        assertFailsWith<IllegalArgumentException> {
+            SafetyQuickAction.InsertText("!").dispatch(dispatcher, editorGeneration = 0L)
+        }
+        assertEquals(1, received.size)
+    }
+
+    private fun dispatcher(received: MutableList<SafetyShellIntent>): SafetyInputEventDispatcher {
+        val route = ExclusiveWriterRoute.bindForSession(
+            sessionId = 12L,
+            selectedRoute = SafetyWriterRoute.SAFETY,
+            safetySink = SafetyEditorSink { intent ->
+                received += intent
+                SafetyDispatchResult.Accepted
+            },
+            legacyFakeSink = null,
+        )
+        return SafetyShellRouter(route).newInputEventDispatcher()
+    }
