+
+package com.opentypeless.routea.safety
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertIs
+
+class SafetyShellRouterTest {
+    @Test
+    fun directQwertyRimeVoiceUndoAndActionTextReachOneSink() {
+        val received = mutableListOf<SafetyShellIntent>()
+        val router = safetyRouter(sessionId = 9L, received = received)
+        val dispatcher = router.newInputEventDispatcher()
+        val expected = listOf(
+            SafetyShellIntent.Text("abc"),
+            SafetyShellIntent.Space,
+            SafetyShellIntent.Delete,
+            SafetyShellIntent.Enter,
+            SafetyShellIntent.RimeKey('n', 3L),
+            SafetyShellIntent.RimeCandidate("乙", 3L),
+            SafetyShellIntent.Voice(3L),
+            SafetyShellIntent.Undo(3L),
+            SafetyShellIntent.QuickActionInsertText("!", 3L),
+        )
+
+        expected.forEach { intent ->
+            assertIs<SafetyDispatchResult.Accepted>(dispatcher.sendDownUp(intent))
+        }
+        assertEquals(expected, received)
+        assertEquals(9L, router.sessionId)
+    }
+
+    @Test
+    fun quickActionKeysNormalizeOnlyToVoiceAndUndoIntents() {
+        val received = mutableListOf<SafetyShellIntent>()
+        val router = safetyRouter(sessionId = 10L, received = received)
+        val dispatcher = router.newInputEventDispatcher()
+
+        SafetyShellIntent.QuickActionKey.entries.forEach { key ->
+            assertIs<SafetyDispatchResult.Accepted>(
+                dispatcher.sendDownUp(SafetyShellIntent.QuickActionInsertKey(key, 10L)),
+            )
+        }
+
+        assertEquals(
+            listOf(
+                SafetyShellIntent.Voice(10L),
+                SafetyShellIntent.Undo(10L),
+            ),
+            received,
+        )
+    }
+
+    @Test
+    fun staleQuickActionGenerationNeverReachesTheCurrentSessionSink() {
+        val received = mutableListOf<SafetyShellIntent>()
+        val dispatcher = safetyRouter(
+            sessionId = 12L,
+            received = received,
+        ).newInputEventDispatcher()
+
+        SafetyShellIntent.QuickActionKey.entries.forEach { key ->
+            assertEquals(
+                SafetyDispatchResult.TargetChanged,
+                dispatcher.sendDownUp(SafetyShellIntent.QuickActionInsertKey(key, 11L)),
+            )
+        }
+        assertEquals(emptyList(), received)
+    }
+
+    @Test
+    fun rejectionIsReturnedAfterOneSelectedSinkCall() {
+        var calls = 0
+        val route = ExclusiveWriterRoute.bindForSession(
+            sessionId = 11L,
+            selectedRoute = SafetyWriterRoute.SAFETY,
+            safetySink = SafetyEditorSink {
+                calls += 1
+                SafetyDispatchResult.Rejected(SafetyRejectionReason.POLICY_DENIED)
+            },
+            legacyFakeSink = null,
+        )
+        val dispatcher = SafetyShellRouter(route).newInputEventDispatcher()
+
+        assertEquals(
+            SafetyDispatchResult.Rejected(SafetyRejectionReason.POLICY_DENIED),
+            dispatcher.sendDownUp(SafetyShellIntent.Text("a")),
+        )
+        assertEquals(1, calls)
+    }
+
+    private fun safetyRouter(
+        sessionId: Long,
+        received: MutableList<SafetyShellIntent>,
+    ): SafetyShellRouter {
+        val route = ExclusiveWriterRoute.bindForSession(
+            sessionId = sessionId,
+            selectedRoute = SafetyWriterRoute.SAFETY,
+            safetySink = SafetyEditorSink { intent ->
+                received += intent
+                SafetyDispatchResult.Accepted
+            },
+            legacyFakeSink = null,
+        )
+        return SafetyShellRouter(route)
+    }
+}
