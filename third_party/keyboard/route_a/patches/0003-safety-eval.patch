+package com.opentypeless.routea.safety
+
+/** Receives one completed, non-cancelled shell input sequence. */
+fun interface SafetyInputEventReceiver {
+    fun onInput(intent: SafetyShellIntent): SafetyDispatchResult
+}
+
+/**
+ * Minimal single-pointer dispatcher used by both real evaluation keys and QuickActions.
+ *
+ * Down never writes. A matching up dispatches exactly once; mismatch, cancellation, and close
+ * fail closed without invoking the receiver. The active intent is bounded by [SafetyShellIntent].
+ */
+class SafetyInputEventDispatcher(
+    private val receiver: SafetyInputEventReceiver,
+) : AutoCloseable {
+    private val lock = Any()
+    private var pressedIntent: SafetyShellIntent? = null
+    private var closed: Boolean = false
+
+    fun sendDown(intent: SafetyShellIntent): SafetyDispatchResult = synchronized(lock) {
+        if (closed) return@synchronized rejected(SafetyRejectionReason.DISPATCHER_CLOSED)
+        if (pressedIntent != null) {
+            return@synchronized rejected(SafetyRejectionReason.INPUT_ALREADY_ACTIVE)
+        }
+        pressedIntent = intent
+        SafetyDispatchResult.Accepted
+    }
+
+    fun sendUp(intent: SafetyShellIntent): SafetyDispatchResult {
+        synchronized(lock) {
+            if (closed) return rejected(SafetyRejectionReason.DISPATCHER_CLOSED)
+            val pressed = pressedIntent
+                ?: return rejected(SafetyRejectionReason.INPUT_SEQUENCE_MISMATCH)
+            pressedIntent = null
+            if (pressed != intent) {
+                return rejected(SafetyRejectionReason.INPUT_SEQUENCE_MISMATCH)
+            }
+        }
+        // The active input is cleared before invoking external code, including a throwing sink.
+        return receiver.onInput(intent)
+    }
+
+    fun sendDownUp(intent: SafetyShellIntent): SafetyDispatchResult {
+        val down = sendDown(intent)
+        if (down !is SafetyDispatchResult.Accepted) return down
+        return sendUp(intent)
+    }
+
+    fun sendCancel(intent: SafetyShellIntent): SafetyDispatchResult = synchronized(lock) {
+        if (closed) return@synchronized rejected(SafetyRejectionReason.DISPATCHER_CLOSED)
+        val pressed = pressedIntent
+            ?: return@synchronized rejected(SafetyRejectionReason.INPUT_SEQUENCE_MISMATCH)
+        pressedIntent = null
+        if (pressed != intent) {
+            rejected(SafetyRejectionReason.INPUT_SEQUENCE_MISMATCH)
+        } else {
+            SafetyDispatchResult.Accepted
+        }
+    }
+
+    override fun close() {
+        synchronized(lock) {
+            pressedIntent = null
+            closed = true
+        }
+    }
+
+    private fun rejected(reason: SafetyRejectionReason): SafetyDispatchResult.Rejected =
+        SafetyDispatchResult.Rejected(reason)
+}
