+        rules = self.rules()
+        self.assertIn("DEXDUMP_MISSING", rules)
+        self.assertIn("EMPTY_DEXDUMP", rules)
+
+    def test_unrecognized_writer_invoke_syntax_fails_closed(self) -> None:
