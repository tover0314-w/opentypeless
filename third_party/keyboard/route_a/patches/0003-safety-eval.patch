+            assertEquals(0, onMainValue { editor.connection.performEditorActionCalls })
+            assertEquals(2, onMainValue { editor.connection.commitCalls })
+
+            onMain { session.click(SafetyTextKeyboardView.TAG_ENTER) }
+            assertEquals(" !", onMainValue { editor.connection.text() })
+            assertEquals(1, onMainValue { editor.connection.performEditorActionCalls })
+        } finally {
+            session.closeAndAwait()
+            onMain { editor.close() }
+        }
+    }
