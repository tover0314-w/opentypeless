+            sessionId = 200L,
+            selectedRoute = SafetyWriterRoute.SAFETY,
+            safetySink = SafetyEditorSink {
+                throwingCalls += 1
+                error("expected")
+            },
+            legacyFakeSink = null,
+        )
+        assertFailsWith<IllegalStateException> {
+            throwingRoute.dispatch(SafetyShellIntent.Enter)
+        }
+        assertEquals(1, throwingCalls)
+    }
