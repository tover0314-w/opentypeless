+def inspect_sources(module_root: Path, producer_prefix: str) -> list[Violation]:
+    violations: list[Violation] = []
+    if not module_root.is_dir():
+        return [
+            Violation("source", "MODULE_ROOT_MISSING", str(module_root), "directory-required")
+        ]
+
+    build_files = _build_files(module_root)
+    if not build_files:
+        violations.append(
+            Violation("source", "MODULE_BUILD_SCRIPT_MISSING", ".", "build.gradle-required")
+        )
+    for path in build_files:
+        relative = str(path.relative_to(module_root))
+        text = _strip_comments(path.read_text(encoding="utf-8"))
+        if not text.strip():
+            violations.append(
+                Violation("source", "EMPTY_BUILD_SCRIPT", relative, "non-empty-input-required")
+            )
+        if any(pattern.search(text) for pattern in _APP_PROJECT_PATTERNS):
+            violations.append(
+                Violation("source", "SAFETY_MODULE_APP_DEPENDENCY", relative, ":app-forbidden")
+            )
+        dependencies_match = _DEPENDENCIES_BLOCK_RE.search(text)
+        if dependencies_match is None:
+            violations.append(
+                Violation(
+                    "source",
+                    "DEPENDENCY_BASELINE",
+                    relative,
+                    "dependencies-block-required",
+                )
+            )
+        else:
+            declarations = frozenset(
+                line.strip()
+                for line in dependencies_match.group(1).splitlines()
+                if line.strip()
+            )
+            if declarations != EXPECTED_DEPENDENCY_DECLARATIONS:
+                missing = EXPECTED_DEPENDENCY_DECLARATIONS - declarations
+                extra = declarations - EXPECTED_DEPENDENCY_DECLARATIONS
+                detail_parts = []
+                if missing:
+                    detail_parts.append(f"missing={len(missing)}")
+                if extra:
+                    detail_parts.append(f"extra={len(extra)}")
+                violations.append(
+                    Violation(
+                        "source",
+                        "DEPENDENCY_BASELINE",
+                        relative,
+                        ",".join(detail_parts) or "declaration-mismatch",
+                    )
+                )
+
+    sources = _production_sources(module_root)
+    if not sources:
+        violations.append(
+            Violation("source", "PRODUCTION_SOURCE_MISSING", ".", "non-empty-input-required")
+        )
+        return violations
+    observed_source_paths = frozenset(
+        path.relative_to(module_root).as_posix() for path in sources
+    )
+    if observed_source_paths != EXPECTED_PRODUCTION_SOURCE_PATHS:
+        missing = EXPECTED_PRODUCTION_SOURCE_PATHS - observed_source_paths
+        extra = observed_source_paths - EXPECTED_PRODUCTION_SOURCE_PATHS
+        detail_parts = []
+        if missing:
+            detail_parts.append(f"missing={len(missing)}")
+        if extra:
+            detail_parts.append(f"extra={len(extra)}")
+        violations.append(
+            Violation(
+                "source",
+                "PRODUCTION_SOURCE_EXACT_BASELINE",
+                ".",
+                ",".join(detail_parts) or "path-mismatch",
+            )
+        )
+
+    producer_count = 0
+    for path in sources:
+        relative = str(path.relative_to(module_root))
+        text = _strip_comments(path.read_text(encoding="utf-8"))
+        if not text.strip():
+            violations.append(
+                Violation("source", "EMPTY_PRODUCTION_SOURCE", relative, "non-empty-input-required")
+            )
+            continue
+        package_match = _PACKAGE_RE.search(text)
+        package_name = package_match.group(1) if package_match else ""
+        expected_package = (
+            "com.opentypeless.ksp004"
+            if relative == "src/main/java/com/opentypeless/ksp004/RimeAdapter.java"
+            else producer_prefix
+        )
+        if package_name != expected_package:
+            violations.append(
+                Violation(
+                    "source",
+                    "PRODUCTION_PACKAGE_EXACT_BASELINE",
+                    relative,
+                    f"expected={expected_package}",
+                )
+            )
+        is_producer = package_name == producer_prefix or package_name.startswith(
+            producer_prefix + "."
+        )
+        if is_producer:
+            producer_count += 1
+            forbidden = _producer_forbidden_tokens(text)
+            if forbidden:
+                violations.append(
+                    Violation(
+                        "source",
+                        "PRODUCER_EDITOR_CAPABILITY",
+                        relative,
+                        ",".join(forbidden),
+                    )
+                )
+        allowed_bridge_source = path.name in {
+            "PortSafetyEditorSink.kt",
+            "SafetyEvalImeService.kt",
+        }
+        references_editor_port = "EditorPort" in text or re.search(
+            r"\beditorPort\s*\(", text
+        )
+        if references_editor_port and not allowed_bridge_source:
+            violations.append(
+                Violation(
+                    "source",
+                    "EXTERNAL_EDITOR_PORT_OWNER",
+                    relative,
+                    "only-PortSafetyEditorSink-or-SafetyEvalImeService",
+                )
+            )
+        references_editor_host = "com.opentypeless.android.editor.host." in text
+        if references_editor_host and not allowed_bridge_source:
+            violations.append(
+                Violation(
+                    "source",
+                    "EXTERNAL_EDITOR_HOST_OWNER",
+                    relative,
+                    "only-PortSafetyEditorSink-or-SafetyEvalImeService",
+                )
+            )
+        dynamic_tokens = {
+            token for token in PRODUCER_DYNAMIC_SOURCE_TOKENS if token in text
+        }
+        is_rime_adapter_source = (
+            package_name == "com.opentypeless.ksp004"
+            and path.name == "RimeAdapter.java"
+        )
+        if is_rime_adapter_source:
+            dynamic_tokens -= {"System.loadLibrary(", " native "}
+        if dynamic_tokens:
+            violations.append(
+                Violation(
+                    "source",
+                    "MODULE_DYNAMIC_CAPABILITY",
+                    relative,
+                    ",".join(sorted(dynamic_tokens)),
+                )
+            )
+        legacy = sorted(token for token in LEGACY_SOURCE_TOKENS if re.search(rf"\b{re.escape(token)}\b", text))
+        if legacy:
+            violations.append(
+                Violation("source", "LEGACY_EDITOR_CLASS", relative, ",".join(legacy))
+            )
+        writers = sorted(set(_SOURCE_WRITE_RE.findall(text)))
+        if writers:
+            violations.append(
+                Violation("source", "EDITOR_WRITE_OUTSIDE_ETM", relative, ",".join(writers))
+            )
+        indirect = sorted(set(_SOURCE_INDIRECT_RE.findall(text)))
+        if indirect:
+            violations.append(
+                Violation(
+                    "source",
+                    "INPUT_METHOD_SERVICE_INDIRECT_WRITER",
+                    relative,
+                    ",".join(indirect),
+                )
+            )
+    if producer_count == 0:
+        violations.append(
+            Violation(
+                "source",
+                "PRODUCER_SOURCE_MISSING",
+                producer_prefix,
+                "at-least-one-production-source-required",
+            )
+        )
+    return violations
+
+
+def _match_class(line: str) -> str | None:
+    for pattern in _CLASS_PATTERNS:
+        match = pattern.search(line)
+        if match:
+            return match.group(1)
+    return None
+
+
+def _match_invocation(line: str) -> tuple[str, MethodRef] | None:
+    if "invoke-" not in line.lower() and not line.lstrip().upper().startswith("INVOKE"):
+        return None
+    canonical = _CANONICAL_INVOKE_RE.search(line)
+    if canonical:
+        return canonical.group(1), MethodRef(canonical.group(2), canonical.group(3))
+    target = _INVOKE_TARGET_RE.search(line)
+    if target:
+        return target.group(1), MethodRef(target.group(2), target.group(3))
+    return None
+
+
+def parse_dexdump(text: str) -> ParsedDexdump:
+    classes: dict[str, list[str]] = {}
+    invocations: list[Invocation] = []
+    current_class = ""
+    current_method: MethodRef | None = None
+    pending_dex_method = False
+    pending_name: str | None = None
+    method_count = 0
+    unparsed_writer_lines: list[int] = []
+    native_methods: list[tuple[str, MethodRef]] = []
+
+    for line_number, line in enumerate(text.splitlines(), start=1):
+        class_name = _match_class(line)
+        if class_name:
+            current_class = class_name
+            classes.setdefault(current_class, [])
+            current_method = None
+            pending_dex_method = False
+            pending_name = None
+        dex_header = _DEX_METHOD_HEADER_RE.search(line)
+        if dex_header:
+            current_class = dex_header.group(1)
+            classes.setdefault(current_class, [])
+            current_method = None
+            pending_dex_method = True
+            pending_name = None
+        if current_class:
+            classes.setdefault(current_class, []).append(line)
+
+        method_match = _CANONICAL_METHOD_RE.search(line) or _SMALI_METHOD_RE.search(line)
+        if method_match:
+            current_method = MethodRef(method_match.group(1), method_match.group(2))
+            method_count += 1
+        elif pending_dex_method:
+            name_match = _DEX_NAME_RE.search(line)
+            if name_match:
+                pending_name = name_match.group(1)
+            type_match = _DEX_TYPE_RE.search(line)
+            if type_match and pending_name is not None:
+                current_method = MethodRef(pending_name, type_match.group(1))
+                method_count += 1
+                pending_dex_method = False
+
+        if current_method is not None and re.search(
+            r"access\s*:\s*0x[0-9a-fA-F]+\s*\([^)]*\bNATIVE\b", line
+        ):
+            native_methods.append((current_class, current_method))
+
+        invocation = _match_invocation(line)
+        if invocation:
+            target_class, target_method = invocation
+            invocations.append(
+                Invocation(
+                    containing_class=current_class,
+                    containing_method=current_method,
+                    target_class=target_class,
+                    target_method=target_method,
+                    line_number=line_number,
+                )
+            )
+        elif "invoke" in line.lower() and any(
+            name in line
+            for name in INPUT_CONNECTION_MUTATOR_NAMES | INPUT_METHOD_SERVICE_INDIRECT_WRITERS
+        ):
+            unparsed_writer_lines.append(line_number)
+
+    return ParsedDexdump(
+        classes={key: "\n".join(value) for key, value in classes.items()},
+        invocations=tuple(invocations),
+        method_count=method_count,
+        unparsed_writer_lines=tuple(unparsed_writer_lines),
+        native_methods=tuple(native_methods),
+    )
+
+
+def _is_input_connection_type(descriptor: str) -> bool:
+    return any(
+        token in descriptor
+        for token in (
+            "InputConnection;",
+            "BaseInputConnection;",
+            "InputConnectionWrapper;",
+            "InputConnectionCompat;",
+        )
+    )
+
+
+def _is_dynamic_capability_invocation(target_class: str, target_name: str) -> bool:
+    if target_class.startswith(_DYNAMIC_CAPABILITY_CLASS_PREFIXES):
+        return True
+    if target_class in _DYNAMIC_CAPABILITY_CLASSES:
+        return True
+    if target_class == "Ljava/lang/Class;" and target_name in _CLASS_DYNAMIC_MEMBERS:
+        return True
+    if target_class in {"Ljava/lang/Runtime;", "Ljava/lang/System;"} and target_name in {
+        "load",
+        "load0",
+        "loadLibrary",
+        "loadLibrary0",
+    }:
+        return True
+    return False
+
+
+def inspect_dexdump(text: str, variant: str, producer_prefix: str) -> list[Violation]:
+    violations: list[Violation] = []
+    if not text.strip():
+        return [
+            Violation(variant, "EMPTY_DEXDUMP", variant, "non-empty-input-required")
+        ]
+
+    parsed = parse_dexdump(text)
+    if not parsed.classes:
+        violations.append(
+            Violation(variant, "DEXDUMP_CLASS_PARSE_FAILED", variant, "class-descriptor-required")
+        )
+    if parsed.method_count == 0:
+        violations.append(
+            Violation(variant, "DEXDUMP_METHOD_PARSE_FAILED", variant, "method-required")
+        )
+    for line_number in parsed.unparsed_writer_lines:
+        violations.append(
+            Violation(
+                variant,
+                "UNPARSED_WRITER_INVOKE",
+                f"line-{line_number}",
+                "unsupported-dexdump-syntax",
+            )
+        )
+
+    producer_descriptor = "L" + producer_prefix.replace(".", "/")
+    producer_sink = _producer_class(producer_prefix, "PortSafetyEditorSink")
+    producer_service = _producer_class(producer_prefix, "SafetyEvalImeService")
+    expected_host_types_by_owner = {
+        producer_sink: frozenset(
+            {EDITOR_PORT, EDITOR_PORT[:-1] + "$VoiceOutcome;"}
+        ),
+        producer_service: frozenset(
+            {EDITOR_PORT, EDITOR_AUTHORITY_INPUT_METHOD_SERVICE}
+        ),
+    }
+    editor_port_class_allowlist = _editor_port_class_allowlist(producer_prefix)
+    artifact_references_editor_port = False
+    requires_external_host_baseline = False
+    producer_classes = 0
+    for class_name, class_text in parsed.classes.items():
+        references_editor_port = class_name == EDITOR_PORT or EDITOR_PORT in class_text
+        artifact_references_editor_port = (
+            artifact_references_editor_port or references_editor_port
+        )
+        if references_editor_port and class_name not in editor_port_class_allowlist:
+            violations.append(
+                Violation(
+                    variant,
+                    "EDITOR_PORT_CAPABILITY_OWNER",
+                    class_name,
+                    "class-not-in-exact-authority-allowlist",
+                )
+            )
+        if _is_input_connection_type(class_text) and not class_name.startswith(
+            EDITOR_HOST_PREFIX
+        ):
+            violations.append(
+                Violation(
+                    variant,
+                    "EDITOR_CAPABILITY_OWNER",
+                    class_name,
+                    "InputConnection-reference-outside-editor-host",
+                )
+            )
+        for legacy_name in LEGACY_CLASS_NAMES:
+            if legacy_name in class_name or legacy_name in class_text:
+                violations.append(
+                    Violation(variant, "LEGACY_EDITOR_CLASS", class_name, legacy_name)
+                )
+        if not class_name.startswith(EDITOR_HOST_PREFIX):
+            observed_host_types = frozenset(
+                _EDITOR_HOST_DESCRIPTOR_RE.findall(class_text)
+            )
+            expected_host_types = expected_host_types_by_owner.get(
+                class_name, frozenset()
+            )
+            requires_external_host_baseline = requires_external_host_baseline or bool(
+                observed_host_types
+            ) or class_name in expected_host_types_by_owner
+            if observed_host_types != expected_host_types:
+                unexpected = observed_host_types - expected_host_types
+                missing = expected_host_types - observed_host_types
+                detail_parts = []
+                if unexpected:
+                    detail_parts.append("unexpected=" + ",".join(sorted(unexpected)))
+                if missing:
+                    detail_parts.append("missing=" + ",".join(sorted(missing)))
+                violations.append(
+                    Violation(
+                        variant,
+                        "EXTERNAL_EDITOR_HOST_TYPE_BASELINE",
+                        class_name,
+                        ",".join(detail_parts) or "type-mismatch",
+                    )
+                )
+        if class_name == producer_descriptor + ";" or class_name.startswith(
+            producer_descriptor + "/"
+        ) or class_name.startswith(producer_descriptor + "$"):
+            producer_classes += 1
+            forbidden = _producer_forbidden_tokens(class_text)
+            if forbidden:
+                violations.append(
+                    Violation(
+                        variant,
+                        "PRODUCER_EDITOR_CAPABILITY",
+                        class_name,
+                        ",".join(forbidden),
+                    )
+                )
+    observed_rime_native_methods: Counter[tuple[str, str]] = Counter()
+    for class_name, method in parsed.native_methods:
+        if not class_name.startswith(OPENTYPELESS_PREFIX):
+            continue
+        if class_name == RIME_ADAPTER:
+            observed_rime_native_methods[(method.name, method.descriptor)] += 1
+        else:
+            violations.append(
+                Violation(
+                    variant,
+                    "OPENTYPELESS_NATIVE_ENTRYPOINT",
+                    class_name,
+                    f"{method.name}{method.descriptor}",
+                )
+            )
+    if RIME_ADAPTER in parsed.classes and observed_rime_native_methods != EXACT_RIME_NATIVE_METHODS:
+        missing = EXACT_RIME_NATIVE_METHODS - observed_rime_native_methods
+        extra = observed_rime_native_methods - EXACT_RIME_NATIVE_METHODS
+        detail_parts = []
+        if missing:
+            detail_parts.append(f"missing={sum(missing.values())}")
+        if extra:
+            detail_parts.append(f"extra={sum(extra.values())}")
+        violations.append(
+            Violation(
+                variant,
+                "RIME_NATIVE_EXACT_BASELINE",
+                RIME_ADAPTER,
+                ",".join(detail_parts) or "count-mismatch",
+            )
+        )
+    if producer_classes == 0:
+        violations.append(
+            Violation(
+                variant,
+                "PRODUCER_CLASS_MISSING",
+                producer_prefix,
+                "wrong-or-empty-artifact",
+            )
+        )
+
+    observed_baseline: Counter[tuple[str, str, str, str]] = Counter()
+    observed_external_host_edges: Counter[
+        tuple[str, str, str, str, str, str]
+    ] = Counter()
+    observed_rime_dynamic_edges: Counter[tuple[str, str, str, str, str]] = Counter()
+    for invocation in parsed.invocations:
+        method = invocation.containing_method
+        target = invocation.target_method
+        subject = invocation.containing_class or f"line-{invocation.line_number}"
+        if invocation.containing_class.startswith(OPENTYPELESS_PREFIX) and (
+            _is_dynamic_capability_invocation(invocation.target_class, target.name)
+        ):
+            dynamic_edge = None
+            if method is not None:
+                dynamic_edge = (
+                    method.name,
+                    method.descriptor,
+                    invocation.target_class,
+                    target.name,
+                    target.descriptor,
+                )
+            if invocation.containing_class == RIME_ADAPTER and dynamic_edge is not None:
+                observed_rime_dynamic_edges[dynamic_edge] += 1
+            else:
+                violations.append(
+                    Violation(
+                        variant,
+                        "OPENTYPELESS_DYNAMIC_CAPABILITY",
+                        subject,
+                        f"{invocation.target_class}->{target.name}{target.descriptor}",
+                    )
+                )
+        if invocation.target_class.startswith(
+            EDITOR_HOST_PREFIX
+        ) and not invocation.containing_class.startswith(EDITOR_HOST_PREFIX):
+            if method is None:
+                violations.append(
+                    Violation(
+                        variant,
+                        "UNATTRIBUTED_EDITOR_PORT_CALL",
+                        subject,
+                        f"{target.name}{target.descriptor}",
+                    )
+                )
+            else:
+                observed_external_host_edges[
+                    (
+                        invocation.containing_class,
+                        method.name,
+                        method.descriptor,
+                        invocation.target_class,
+                        target.name,
+                        target.descriptor,
+                    )
+                ] += 1
+        if target.name in INPUT_METHOD_SERVICE_INDIRECT_WRITERS:
+            violations.append(
+                Violation(
+                    variant,
+                    "INPUT_METHOD_SERVICE_INDIRECT_WRITER",
+                    subject,
+                    target.name,
+                )
+            )
+
+        target_is_ic = _is_input_connection_type(invocation.target_class)
+        if target_is_ic and target.name not in (
+            INPUT_CONNECTION_MUTATOR_NAMES | READ_ONLY_INPUT_CONNECTION_NAMES
+        ):
+            violations.append(
+                Violation(
+                    variant,
+                    "UNKNOWN_INPUT_CONNECTION_MEMBER",
+                    subject,
+                    target.name,
+                )
+            )
+        # A façade/sub-interface may hide the InputConnection descriptor.  Mutator names are
+        # therefore authorization-bearing regardless of the apparent target type; only the exact
+        # framework edges below receive permission.
+        if target.name not in INPUT_CONNECTION_MUTATOR_NAMES:
+            continue
+
+        if method is None:
+            violations.append(
+                Violation(
+                    variant,
+                    "UNATTRIBUTED_EDITOR_WRITE",
+                    subject,
+                    f"{target.name}{target.descriptor}",
+                )
+            )
+            continue
+        edge = (method.name, method.descriptor, target.name, target.descriptor)
+        if invocation.containing_class != EDITOR_TRANSACTION_MANAGER:
+            violations.append(
+                Violation(
+                    variant,
+                    "EDITOR_WRITE_OWNER",
+                    subject,
+                    f"{target.name}{target.descriptor}",
+                )
+            )
+            continue
+        if invocation.target_class != INPUT_CONNECTION or edge not in EXACT_ETM_WRITER_BASELINE:
+            violations.append(
+                Violation(
+                    variant,
+                    "EDITOR_TRANSACTION_WRITE_SURFACE",
+                    subject,
+                    f"{method.name}->{target.name}{target.descriptor}",
+                )
+            )
+            continue
+        observed_baseline[edge] += 1
+
+    if observed_baseline != EXACT_ETM_WRITER_BASELINE:
+        missing = EXACT_ETM_WRITER_BASELINE - observed_baseline
+        extra = observed_baseline - EXACT_ETM_WRITER_BASELINE
+        detail_parts = []
+        if missing:
+            detail_parts.append(f"missing={sum(missing.values())}")
+        if extra:
+            detail_parts.append(f"extra={sum(extra.values())}")
+        violations.append(
+            Violation(
+                variant,
+                "EDITOR_TRANSACTION_EXACT_WRITE_BASELINE",
+                EDITOR_TRANSACTION_MANAGER,
+                ",".join(detail_parts) or "count-mismatch",
+            )
+        )
+    if RIME_ADAPTER in parsed.classes and observed_rime_dynamic_edges != EXACT_RIME_DYNAMIC_EDGES:
+        missing = EXACT_RIME_DYNAMIC_EDGES - observed_rime_dynamic_edges
+        extra = observed_rime_dynamic_edges - EXACT_RIME_DYNAMIC_EDGES
+        detail_parts = []
+        if missing:
+            detail_parts.append(f"missing={sum(missing.values())}")
+        if extra:
+            detail_parts.append(f"extra={sum(extra.values())}")
+        violations.append(
+            Violation(
+                variant,
+                "RIME_DYNAMIC_EXACT_BASELINE",
+                RIME_ADAPTER,
+                ",".join(detail_parts) or "count-mismatch",
+            )
+        )
+    if requires_external_host_baseline:
+        expected_external_host_edges = _expected_producer_host_edges(producer_prefix)
+        if observed_external_host_edges != expected_external_host_edges:
+            missing = expected_external_host_edges - observed_external_host_edges
+            extra = observed_external_host_edges - expected_external_host_edges
+            detail_parts = []
+            if missing:
+                detail_parts.append(f"missing={sum(missing.values())}")
+            if extra:
+                detail_parts.append(f"extra={sum(extra.values())}")
+            violations.append(
+                Violation(
+                    variant,
+                    "EXTERNAL_EDITOR_HOST_EXACT_EDGE_BASELINE",
+                    EDITOR_HOST_PREFIX,
+                    ",".join(detail_parts) or "count-mismatch",
+                )
+            )
+    return violations
+
+
+def verify(
+    module_root: Path,
+    debug_dexdump: Path,
+    release_dexdump: Path,
+    producer_prefix: str = DEFAULT_PRODUCER_PREFIX,
+) -> tuple[Violation, ...]:
+    violations = inspect_sources(module_root, producer_prefix)
+    for variant, path in (("debug", debug_dexdump), ("release", release_dexdump)):
+        if not path.is_file():
+            violations.append(
+                Violation(variant, "DEXDUMP_MISSING", str(path), "artifact-required")
+            )
+            continue
+        try:
+            text = path.read_text(encoding="utf-8")
+        except UnicodeError:
+            violations.append(
+                Violation(variant, "DEXDUMP_NOT_UTF8", str(path), "text-input-required")
+            )
+            continue
+        violations.extend(inspect_dexdump(text, variant, producer_prefix))
+    return tuple(sorted(set(violations)))
+
+
+def _parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--module-root", type=Path, required=True)
+    parser.add_argument("--debug-dexdump", type=Path, required=True)
+    parser.add_argument("--release-dexdump", type=Path, required=True)
+    parser.add_argument("--producer-prefix", default=DEFAULT_PRODUCER_PREFIX)
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    args = _parser().parse_args(argv)
+    producer_prefix = args.producer_prefix.strip().strip(".")
+    if not producer_prefix or "/" in producer_prefix:
+        print("source:INVALID_PRODUCER_PREFIX:producer-prefix:fqcn-required", file=sys.stderr)
+        return 2
+    violations = verify(
+        args.module_root.resolve(),
+        args.debug_dexdump.resolve(),
+        args.release_dexdump.resolve(),
+        producer_prefix,
+    )
+    if violations:
+        for violation in violations:
+            print(violation.render(), file=sys.stderr)
+        print(f"route-a safety architecture failed: {len(violations)} violation(s)", file=sys.stderr)
+        return 1
+    print("route-a safety architecture passed: source + debug/release compiled gates")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
