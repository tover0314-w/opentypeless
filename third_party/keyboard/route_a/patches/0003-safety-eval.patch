+
+package com.opentypeless.routea.safety
+
+/**
+ * Closed, capability-free input vocabulary for the Route-A safety evaluation shell.
+ *
+ * These values contain no Android object, editor handle, arbitrary key code, or fallback target.
+ * Text is bounded before it can cross the writer-route boundary.
+ */
+sealed interface SafetyShellIntent {
+    data class Text(val text: String) : SafetyShellIntent {
+        init {
+            SafetyIntentValidation.requireBoundedText(text, "text")
+        }
+    }
+
+    data object Space : SafetyShellIntent
+
+    data object Delete : SafetyShellIntent
+
+    data object Enter : SafetyShellIntent
+
+    data class RimeKey(
+        val key: Char,
+        val editorGeneration: Long,
+    ) : SafetyShellIntent {
+        init {
+            require(key in 'a'..'z') { "Rime keys must be lowercase ASCII" }
+            SafetyIntentValidation.requireGeneration(editorGeneration)
+        }
+    }
+
+    data class RimeCandidate(
+        val text: String,
+        val editorGeneration: Long,
+    ) : SafetyShellIntent {
+        init {
+            SafetyIntentValidation.requireBoundedText(text, "Rime candidate")
+            SafetyIntentValidation.requireGeneration(editorGeneration)
+        }
+    }
+
+    /** Advances the bounded evaluation Voice state machine by one step. */
+    data class Voice(val editorGeneration: Long) : SafetyShellIntent {
+        init {
+            SafetyIntentValidation.requireGeneration(editorGeneration)
+        }
+    }
+
+    /** Requests exact-ID Voice undo from the session-owned editor sink. */
+    data class Undo(val editorGeneration: Long) : SafetyShellIntent {
+        init {
+            SafetyIntentValidation.requireGeneration(editorGeneration)
+        }
+    }
+
+    /**
+     * QuickAction key input is deliberately allowlisted. It cannot carry an arbitrary platform
+     * key code, Intent, or recursive QuickAction.
+     */
+    data class QuickActionInsertKey(
+        val key: QuickActionKey,
+        val editorGeneration: Long,
+    ) : SafetyShellIntent {
+        init {
+            SafetyIntentValidation.requireGeneration(editorGeneration)
+        }
+    }
+
+    data class QuickActionInsertText(
+        val text: String,
+        val editorGeneration: Long,
+    ) : SafetyShellIntent {
+        init {
+            SafetyIntentValidation.requireBoundedText(text, "QuickAction text")
+            SafetyIntentValidation.requireGeneration(editorGeneration)
+        }
+    }
+
+    enum class QuickActionKey {
+        VOICE,
+        UNDO,
+    }
+
+}
+
+internal object SafetyIntentValidation {
+    private const val MAX_TEXT_CODE_POINTS: Int = 256
+
+    fun requireBoundedText(value: String, name: String) {
+        require(value.isNotEmpty()) { "$name must not be empty" }
+        require(value.codePointCount(0, value.length) <= MAX_TEXT_CODE_POINTS) {
+            "$name exceeds $MAX_TEXT_CODE_POINTS code points"
+        }
+    }
+
+    fun requireGeneration(value: Long) {
+        require(value > 0L) { "editorGeneration must be positive" }
+    }
+}
+
+/** The only capability exposed to the writer-free shell. */
+fun interface SafetyEditorSink {
+    fun dispatch(intent: SafetyShellIntent): SafetyDispatchResult
+}
+
+/** Content-free result returned to the shell; no editor or plaintext evidence is exposed. */
+sealed interface SafetyDispatchResult {
+    data object Accepted : SafetyDispatchResult
+
+    data class Rejected(val reason: SafetyRejectionReason) : SafetyDispatchResult
+
+    data object TargetChanged : SafetyDispatchResult
+}
+
+enum class SafetyRejectionReason {
+    POLICY_DENIED,
+    UNSUPPORTED_INPUT,
+    INPUT_ALREADY_ACTIVE,
+    INPUT_SEQUENCE_MISMATCH,
+    DISPATCHER_CLOSED,
+}
