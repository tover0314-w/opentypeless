+package com.opentypeless.routea.safety
+
+/** Evaluation QuickActions emit bounded shell intents and never receive editor authority. */
+sealed interface SafetyQuickAction {
+    data class InsertKey(val key: SafetyShellIntent.QuickActionKey) : SafetyQuickAction
+
+    data class InsertText(val text: String) : SafetyQuickAction {
+        init {
+            SafetyIntentValidation.requireBoundedText(text, "QuickAction text")
+        }
+    }
+
+    fun dispatch(
+        dispatcher: SafetyInputEventDispatcher,
+        editorGeneration: Long,
+    ): SafetyDispatchResult {
+        val intent = when (this) {
+            is InsertKey -> SafetyShellIntent.QuickActionInsertKey(key, editorGeneration)
+            is InsertText -> SafetyShellIntent.QuickActionInsertText(text, editorGeneration)
+        }
+        return dispatcher.sendDownUp(intent)
+    }
+}
