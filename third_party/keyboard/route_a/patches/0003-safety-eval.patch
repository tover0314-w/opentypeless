+}
+
+val manifestVerifier = rootProject.layout.projectDirectory.file(
+    "tools/verify_route_a_safety_manifest.py",
+)
+val architectureVerifier = layout.projectDirectory.file(
+    "tools/verify_route_a_safety_architecture.py",
+)
+val sourceManifest = layout.projectDirectory.file("src/main/AndroidManifest.xml")
+val methodXml = layout.projectDirectory.file("src/main/res/xml/method.xml")
+val backupRulesXml = layout.projectDirectory.file("src/main/res/xml/backup_rules.xml")
+val dataExtractionRulesXml = layout.projectDirectory.file(
+    "src/main/res/xml/data_extraction_rules.xml",
+)
+val verifyRouteASafetyNoVariantResourceOverrides = tasks.register(
+    "verifyRouteASafetyNoVariantResourceOverrides",
+) {
+    group = "verification"
+    description = "Rejects build-type or flavor overrides of security-critical XML resources."
+    inputs.dir(layout.projectDirectory.dir("src"))
+    doLast {
+        val excludedSourceSets = setOf("main", "androidTest", "test", "testFixtures")
+        val protectedResources = setOf(
+            "res/xml/backup_rules.xml",
+            "res/xml/data_extraction_rules.xml",
+            "res/xml/method.xml",
+        )
+        val sourceRoot = layout.projectDirectory.dir("src").asFile
+        val forbidden = sourceRoot.listFiles().orEmpty()
+            .filter { it.isDirectory && it.name !in excludedSourceSets }
+            .flatMap { sourceSet ->
+                protectedResources.map { relative -> sourceSet.resolve(relative) }
+            }
+            .filter { it.exists() }
+        if (forbidden.isNotEmpty()) {
+            throw GradleException(
+                "Route-A safety forbids variant overrides of security-critical resources: " +
+                    forbidden.joinToString { it.relativeTo(projectDir).invariantSeparatorsPath },
+            )
+        }
+    }
+}
+val producerNamespace = "com.opentypeless.routea.safety"
+val configuredBuildToolsVersion = tools.versions.buildTools.get()
+val dexdumpFileName = if (System.getProperty("os.name").startsWith("Windows")) {
+    "dexdump.exe"
+} else {
+    "dexdump"
+}
+
+val androidComponents = extensions.getByType<ApplicationAndroidComponentsExtension>()
+val routeASafetyDexdumpExecutable = androidComponents.sdkComponents.sdkDirectory.map { sdkDirectory ->
+    sdkDirectory.file("build-tools/$configuredBuildToolsVersion/$dexdumpFileName")
+}
+
+fun org.gradle.api.tasks.Exec.configureManifestGate(manifest: Any) {
+    inputs.files(manifestVerifier, manifest, methodXml, backupRulesXml, dataExtractionRulesXml)
+    doFirst {
+        commandLine(
+            "python3",
+            manifestVerifier.asFile.absolutePath,
+            "--manifest",
+            when (manifest) {
+                is org.gradle.api.file.RegularFile -> manifest.asFile.absolutePath
+                is org.gradle.api.provider.Provider<*> ->
+                    (manifest.get() as org.gradle.api.file.RegularFile).asFile.absolutePath
+                else -> manifest.toString()
+            },
+            "--method",
+            methodXml.asFile.absolutePath,
+            "--backup-rules",
+            backupRulesXml.asFile.absolutePath,
+            "--data-extraction-rules",
+            dataExtractionRulesXml.asFile.absolutePath,
+        )
+    }
+}
+
+val verifyRouteASafetySourceManifest = tasks.register<Exec>(
+    "verifyRouteASafetySourceManifest",
+) {
+    group = "verification"
+    description = "Verifies the fail-closed Route-A safety source manifest and backup rules."
+    configureManifestGate(sourceManifest.asFile)
+}
+
+listOf("debug", "release").forEach { requiredVariant ->
+    androidComponents.onVariants(androidComponents.selector().withBuildType(requiredVariant)) { variant ->
+        val capitalizedName = variant.name.replaceFirstChar { it.uppercase() }
+        val mergedManifest = variant.artifacts.get(SingleArtifact.MERGED_MANIFEST)
+        val finalApkDirectory = variant.artifacts.get(SingleArtifact.APK)
+
+        tasks.register<Exec>("verifyRouteASafety${capitalizedName}MergedManifest") {
+            group = "verification"
+            description = "Verifies the real $requiredVariant merged Route-A safety manifest."
+            configureManifestGate(mergedManifest)
+        }
+
+        tasks.register<GenerateRouteASafetyDexdumpTask>(
+            "generateRouteASafety${capitalizedName}Dexdump",
+        ) {
+            group = "verification"
+            description = "Disassembles every dex from the final $requiredVariant safety APK."
+            apkDirectory.set(finalApkDirectory)
+            dexdumpExecutable.set(routeASafetyDexdumpExecutable)
+            outputFile.set(
+                layout.buildDirectory.file(
+                    "reports/route-a-safety/$requiredVariant.dexdump.txt",
+                ),
+            )
+        }
+    }
+}
+
+val debugDexdump = layout.buildDirectory.file("reports/route-a-safety/debug.dexdump.txt")
+val releaseDexdump = layout.buildDirectory.file("reports/route-a-safety/release.dexdump.txt")
+val verifyRouteASafetyArchitecture = tasks.register<Exec>("verifyRouteASafetyArchitecture") {
+    group = "verification"
+    description = "Verifies source plus whole-APK Debug/Release Route-A editor authority."
+    dependsOn(
+        "generateRouteASafetyDebugDexdump",
+        "generateRouteASafetyReleaseDexdump",
+    )
+    inputs.file(architectureVerifier)
+    inputs.file(layout.projectDirectory.file("build.gradle.kts"))
+    inputs.dir(layout.projectDirectory.dir("src/main"))
+    inputs.files(debugDexdump, releaseDexdump)
+    doFirst {
+        commandLine(
+            "python3",
+            architectureVerifier.asFile.absolutePath,
+            "--module-root",
+            layout.projectDirectory.asFile.absolutePath,
+            "--debug-dexdump",
+            debugDexdump.get().asFile.absolutePath,
+            "--release-dexdump",
+            releaseDexdump.get().asFile.absolutePath,
+            "--producer-prefix",
+            producerNamespace,
+        )
+    }
+}
+
+val verifyRouteASafetyHardGates = tasks.register("verifyRouteASafetyHardGates") {
+    group = "verification"
+    description = "Runs source, merged-manifest, and whole-APK compiled Route-A safety gates."
+    dependsOn(
+        verifyRouteASafetySourceManifest,
+        verifyRouteASafetyNoVariantResourceOverrides,
+        "verifyRouteASafetyDebugMergedManifest",
+        "verifyRouteASafetyReleaseMergedManifest",
+        verifyRouteASafetyArchitecture,
+    )
+}
+
+tasks.matching {
+    it.name in setOf("check", "assemble", "assembleDebug", "assembleRelease")
+}.configureEach {
+    dependsOn(verifyRouteASafetyHardGates)
+}
+
+tasks.matching {
+    it.name in setOf("bundleDebug", "bundleRelease", "installDebug", "installRelease")
+}.configureEach {
+    dependsOn(verifyRouteASafetyHardGates)
+}
+
+tasks.matching {
+    it.name in setOf("packageDebug", "packageRelease")
+}.configureEach {
+    finalizedBy(verifyRouteASafetyHardGates)
+}
