+/**
+ * Real-View proof for the independent Route-A safety evaluation artifact.
+ *
+ * The test package deliberately sits inside the editor-host authority enclave so it can construct
+ * the package-confined [EditorPort]. Production Shell/Rime/Voice/QuickAction code still receives
+ * only that capability-free port and all physical writes remain inside EditorTransactionManager.
+ */
+@RunWith(AndroidJUnit4::class)
+class SafetyRouteAInstrumentedTest {
+    @Test
+    fun realViewLatinDeleteEnterAndQuickActionsUseTheSafetyRoute() {
+        val context = targetContext()
+        val editor = onMainValue { EditorHarness.normal(context, "", 0) }
+        val session = onMainValue { PlaintextSafetySession.create(context, editor.port) }
+        try {
+            onMain {
+                session.click(SafetyTextKeyboardView.TAG_KEY_A)
+                session.click(SafetyTextKeyboardView.TAG_KEY_B)
+                session.click(SafetyTextKeyboardView.TAG_KEY_C)
+                session.click(SafetyTextKeyboardView.TAG_SPACE)
+                session.click(SafetyTextKeyboardView.TAG_DELETE)
+                session.click(SafetyTextKeyboardView.TAG_ENTER)
+                session.click(SafetyTextKeyboardView.TAG_ACTION_SPACE)
+                session.click(SafetyTextKeyboardView.TAG_ACTION_TEXT)
+            }
+
+            assertEquals("abc\n !", onMainValue { editor.connection.text() })
+            assertEquals(8, onMainValue { editor.connection.totalMutatorCalls() })
+            assertEquals(8, onMainValue { editor.connection.beginCalls })
+            assertEquals(8, onMainValue { editor.connection.endCalls })
+        } finally {
+            session.closeAndAwait()
+            onMain { editor.close() }
+        }
+    }
+
