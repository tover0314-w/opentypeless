+/*
+ * Copyright (C) 2026 OpenTypeless Contributors
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ */
+
+package com.opentypeless.routea.safety
+
+import android.content.Context
+import com.opentypeless.ksp004.RimeAdapter
+import java.io.File
+import java.io.IOException
+import java.nio.file.FileVisitResult
+import java.nio.file.Files
+import java.nio.file.Path
+import java.nio.file.SimpleFileVisitor
+import java.nio.file.attribute.BasicFileAttributes
+import java.util.Collections
+import java.util.UUID
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicReference
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+
+/**
+ * Generation-bound, editor-capability-free owner of the Route-A evaluation Rime runtime.
+ *
+ * Native initialization, schema deployment, key processing, candidate selection, and teardown all
+ * run on one background worker. The controller never accepts an editor object or writer callback;
+ * it emits bounded domain output which the safety sink may separately submit to EditorTransaction.
+ */
+class SafetyRimeController private constructor(
+    val editorGeneration: Long,
+    parentScope: CoroutineScope,
+    private val workerDispatcher: CoroutineDispatcher,
+    private val callbackDispatcher: CoroutineDispatcher,
+    private val rootFactory: SafetyRimeRootFactory,
+    private val engineFactory: SafetyRimeEngineFactory,
+    private val onOutput: (SafetyRimeOutput) -> Unit,
+) : AutoCloseable {
+    constructor(
+        context: Context,
+        editorGeneration: Long,
+        parentScope: CoroutineScope,
+        onOutput: (SafetyRimeOutput) -> Unit,
+    ) : this(
+        editorGeneration = editorGeneration,
+        parentScope = parentScope,
+        workerDispatcher = Dispatchers.IO,
+        callbackDispatcher = Dispatchers.Main.immediate,
+        rootFactory = NoBackupRimeRootFactory(context.applicationContext.noBackupFilesDir),
+        engineFactory = AdapterRimeEngineFactory(context.applicationContext),
+        onOutput = onOutput,
+    )
+
+    private val validatedGeneration = editorGeneration.also {
+        require(it > 0L) { "editorGeneration must be positive" }
+    }
+    private val accepting = AtomicBoolean(true)
+    private val acceptedKeyCount = AtomicInteger(0)
+    private val terminalFailure = AtomicReference<SafetyRimeFailureKind?>(null)
+    private val commandQueue = Channel<Command>(capacity = MAX_PENDING_COMMANDS)
+    private val lifecycleJob = SupervisorJob(
+        requireNotNull(parentScope.coroutineContext[Job]) {
+            "parentScope must have a lifecycle Job"
+        },
+    )
+    private val scope = CoroutineScope(parentScope.coroutineContext + lifecycleJob)
+    private val workerJob = scope.launch(workerDispatcher) {
+        try {
+            PROCESS_ENGINE_MUTEX.withLock {
+                runEngine()
+            }
+        } finally {
+            accepting.set(false)
+            commandQueue.cancel()
+        }
+    }
+
+    /** Queues one lowercase ASCII Rime key without performing native work on the caller thread. */
+    fun processKey(key: Char, editorGeneration: Long): SafetyRimeEnqueueResult {
+        require(key in 'a'..'z') { "Rime keys must be lowercase ASCII" }
+        generationResult(editorGeneration)?.let { return it }
+        if (!reserveBoundedKey()) return SafetyRimeEnqueueResult.BACKPRESSURE
+
+        val sent = commandQueue.trySend(Command.ProcessKey(key, editorGeneration))
+        if (sent.isSuccess) return SafetyRimeEnqueueResult.QUEUED
+
+        acceptedKeyCount.decrementAndGet()
+        return if (sent.isClosed || !accepting.get()) {
+            SafetyRimeEnqueueResult.CLOSED
+        } else {
+            SafetyRimeEnqueueResult.BACKPRESSURE
+        }
+    }
+
+    /** Queues one allowlisted candidate identity; the worker rejects a stale candidate page. */
+    fun selectCandidate(
+        index: Int,
+        expectedCandidate: String,
+        editorGeneration: Long,
+    ): SafetyRimeEnqueueResult {
+        require(index in 0 until MAX_CANDIDATES) { "Rime candidate index is outside the bounded page" }
+        requireBoundedRimeText(expectedCandidate, allowEmpty = false)
+        generationResult(editorGeneration)?.let { return it }
+
+        val sent = commandQueue.trySend(
+            Command.SelectCandidate(index, expectedCandidate, editorGeneration),
+        )
+        if (sent.isSuccess) return SafetyRimeEnqueueResult.QUEUED
+        return if (sent.isClosed || !accepting.get()) {
+            SafetyRimeEnqueueResult.CLOSED
+        } else {
+            SafetyRimeEnqueueResult.BACKPRESSURE
+        }
+    }
+
+    /** Revokes Rime immediately when the current field becomes sensitive. */
+    fun closeForSensitiveField() = close()
+
+    /**
+     * Stops accepting input and cancels queued/in-flight delivery. Native close and no-backup
+     * storage cleanup execute in the worker's structured `finally` block.
+     */
+    override fun close() {
+        if (accepting.compareAndSet(true, false)) {
+            commandQueue.cancel()
+            lifecycleJob.cancel()
+        }
+    }
+
+    private fun generationResult(value: Long): SafetyRimeEnqueueResult? {
+        require(value > 0L) { "editorGeneration must be positive" }
+        if (value != editorGeneration) return SafetyRimeEnqueueResult.STALE_GENERATION
+        if (!accepting.get()) return SafetyRimeEnqueueResult.CLOSED
+        return null
+    }
+
+    private fun reserveBoundedKey(): Boolean {
+        while (true) {
+            val current = acceptedKeyCount.get()
+            if (current >= MAX_ASCII_INPUT) return false
+            if (acceptedKeyCount.compareAndSet(current, current + 1)) return true
+        }
+    }
+
+    private suspend fun runEngine() {
+        var root: SafetyRimeEphemeralRoot? = null
+        var engine: SafetyRimeEngine? = null
+        try {
+            root = try {
+                rootFactory.create(validatedGeneration)
+            } catch (_: Exception) {
+                recordFailure(SafetyRimeFailureKind.STORAGE_FAILED)
+                deliverFailure(SafetyRimeFailureKind.STORAGE_FAILED)
+                return
+            }
+            ensureActiveAndCurrent()
+
+            engine = try {
+                engineFactory.open(root.directory)
+            } catch (_: Exception) {
+                recordFailure(SafetyRimeFailureKind.INITIALIZATION_FAILED)
+                deliverFailure(SafetyRimeFailureKind.INITIALIZATION_FAILED)
+                return
+            } catch (_: LinkageError) {
+                recordFailure(SafetyRimeFailureKind.INITIALIZATION_FAILED)
+                deliverFailure(SafetyRimeFailureKind.INITIALIZATION_FAILED)
+                return
+            }
+            ensureActiveAndCurrent()
+
+            val input = StringBuilder(MAX_ASCII_INPUT)
+            var candidatePage: List<String> = emptyList()
+            for (command in commandQueue) {
+                ensureActiveAndCurrent(command.editorGeneration)
+                try {
+                    when (command) {
+                        is Command.ProcessKey -> {
+                            if (input.length >= MAX_ASCII_INPUT) {
+                                throw InvalidRimeOutputException()
+                            }
+                            input.append(command.key)
+                            val snapshot = engine.processAscii(input.toString())
+                            val output = SafetyRimeOutput.Composition(
+                                editorGeneration = editorGeneration,
+                                preedit = snapshot.preedit,
+                                candidates = snapshot.candidates,
+                            )
+                            candidatePage = output.candidates
+                            deliver(output, command.editorGeneration)
+                        }
+
+                        is Command.SelectCandidate -> {
+                            if (candidatePage.getOrNull(command.index)
+                                != command.expectedCandidate
+                            ) {
+                                throw InvalidRimeOutputException()
+                            }
+                            val selected = engine.selectCandidate(command.index)
+                            if (selected != command.expectedCandidate) {
+                                throw InvalidRimeOutputException()
+                            }
+                            val output = SafetyRimeOutput.Commit(
+                                editorGeneration = editorGeneration,
+                                text = selected,
+                            )
+                            input.setLength(0)
+                            candidatePage = emptyList()
+                            acceptedKeyCount.set(0)
+                            deliver(output, command.editorGeneration)
+                        }
+                    }
+                } catch (cancelled: CancellationException) {
+                    throw cancelled
+                } catch (_: InvalidRimeOutputException) {
+                    recordFailure(SafetyRimeFailureKind.INVALID_OUTPUT)
+                    deliverFailure(SafetyRimeFailureKind.INVALID_OUTPUT)
+                    return
+                } catch (_: IllegalArgumentException) {
+                    recordFailure(SafetyRimeFailureKind.INVALID_OUTPUT)
+                    deliverFailure(SafetyRimeFailureKind.INVALID_OUTPUT)
+                    return
+                } catch (_: Exception) {
+                    recordFailure(SafetyRimeFailureKind.PROCESSING_FAILED)
+                    deliverFailure(SafetyRimeFailureKind.PROCESSING_FAILED)
+                    return
+                }
+            }
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } finally {
+            accepting.set(false)
+            commandQueue.cancel()
+            try {
+                closeEngine(engine)
+            } finally {
+                cleanRoot(root)
+            }
+        }
+    }
+
+    private suspend fun deliverFailure(kind: SafetyRimeFailureKind) {
+        deliver(SafetyRimeOutput.Failure(editorGeneration, kind), editorGeneration)
+    }
+
+    private suspend fun deliver(output: SafetyRimeOutput, commandGeneration: Long) {
+        ensureActiveAndCurrent(commandGeneration)
+        withContext(callbackDispatcher) {
+            ensureActiveAndCurrent(commandGeneration)
+            onOutput(output)
+        }
+    }
+
+    private fun ensureActiveAndCurrent(commandGeneration: Long = editorGeneration) {
+        scope.coroutineContext.ensureActive()
+        if (!accepting.get() || commandGeneration != editorGeneration) throw CancellationException()
+    }
+
+    private fun closeEngine(engine: SafetyRimeEngine?) {
+        try {
+            engine?.close()
+        } catch (_: Exception) {
+            recordFailure(SafetyRimeFailureKind.PROCESSING_FAILED)
+            // Teardown continues to the mandatory storage cleanup after the content-free failure
+            // class is retained. No raw native message crosses the controller boundary.
+        } catch (_: LinkageError) {
+            recordFailure(SafetyRimeFailureKind.PROCESSING_FAILED)
+        }
+    }
+
+    private fun cleanRoot(root: SafetyRimeEphemeralRoot?) {
+        if (root == null) return
+        try {
+            deleteEphemeralRoot(root)
+        } catch (_: Exception) {
+            recordFailure(SafetyRimeFailureKind.STORAGE_FAILED)
+            // Fail closed: the directory is under noBackup and remains excluded from transfer.
+            // A later controller creation performs a bounded stale-session sweep.
+        }
+    }
+
+    private fun recordFailure(kind: SafetyRimeFailureKind) {
+        terminalFailure.compareAndSet(null, kind)
+    }
+
+    internal suspend fun awaitClosedForTest() {
+        workerJob.join()
+    }
+
+    internal fun terminalFailureForTest(): SafetyRimeFailureKind? = terminalFailure.get()
+
+    private sealed interface Command {
+        val editorGeneration: Long
+
+        data class ProcessKey(
+            val key: Char,
+            override val editorGeneration: Long,
+        ) : Command
+
+        data class SelectCandidate(
+            val index: Int,
+            val expectedCandidate: String,
+            override val editorGeneration: Long,
+        ) : Command
+    }
+
+    internal companion object {
+        private const val MAX_PENDING_COMMANDS = 8
+        private const val MAX_ASCII_INPUT = 128
+        private const val MAX_CANDIDATES = 16
+        private val PROCESS_ENGINE_MUTEX = Mutex()
+
+        internal fun createForTest(
+            editorGeneration: Long,
+            parentScope: CoroutineScope,
+            workerDispatcher: CoroutineDispatcher,
+            callbackDispatcher: CoroutineDispatcher,
+            rootFactory: SafetyRimeRootFactory,
+            engineFactory: SafetyRimeEngineFactory,
+            onOutput: (SafetyRimeOutput) -> Unit,
+        ): SafetyRimeController = SafetyRimeController(
+            editorGeneration = editorGeneration,
+            parentScope = parentScope,
+            workerDispatcher = workerDispatcher,
+            callbackDispatcher = callbackDispatcher,
+            rootFactory = rootFactory,
+            engineFactory = engineFactory,
+            onOutput = onOutput,
+        )
+    }
+}
+
+enum class SafetyRimeEnqueueResult {
+    QUEUED,
+    STALE_GENERATION,
+    CLOSED,
+    BACKPRESSURE,
+}
+
+/** Bounded Rime data which carries no Android or editor capability. */
+sealed interface SafetyRimeOutput {
+    val editorGeneration: Long
+
+    class Composition(
+        override val editorGeneration: Long,
+        val preedit: String,
+        candidates: List<String>,
+    ) : SafetyRimeOutput {
+        val candidates: List<String> = Collections.unmodifiableList(ArrayList(candidates))
+
+        init {
+            requireGeneration(editorGeneration)
+            requireBoundedRimeText(preedit, allowEmpty = true)
+            require(this.candidates.size <= MAX_RIME_CANDIDATES) {
+                "Rime candidate page exceeds $MAX_RIME_CANDIDATES items"
+            }
+            this.candidates.forEach { requireBoundedRimeText(it, allowEmpty = false) }
+        }
+
+        override fun toString(): String =
+            "Composition{editorGeneration=$editorGeneration," +
+                "preeditLength=${preedit.length},candidateCount=${candidates.size}}"
+    }
+
+    class Commit(
+        override val editorGeneration: Long,
+        val text: String,
+    ) : SafetyRimeOutput {
+        init {
+            requireGeneration(editorGeneration)
+            requireBoundedRimeText(text, allowEmpty = false)
+        }
+
+        override fun toString(): String =
+            "Commit{editorGeneration=$editorGeneration,textLength=${text.length}}"
+    }
+
+    class Failure(
+        override val editorGeneration: Long,
+        val kind: SafetyRimeFailureKind,
+    ) : SafetyRimeOutput {
+        init {
+            requireGeneration(editorGeneration)
+        }
+
+        override fun toString(): String =
+            "Failure{editorGeneration=$editorGeneration,kind=$kind}"
+    }
+}
+
+enum class SafetyRimeFailureKind {
+    INITIALIZATION_FAILED,
+    PROCESSING_FAILED,
+    INVALID_OUTPUT,
+    STORAGE_FAILED,
+}
+
+internal class SafetyRimeEngineSnapshot(
+    val preedit: String,
+    candidates: List<String>,
+) {
+    val candidates: List<String> = Collections.unmodifiableList(ArrayList(candidates))
+
+    override fun toString(): String =
+        "SafetyRimeEngineSnapshot{preeditLength=${preedit.length},candidateCount=${candidates.size}}"
+}
+
+internal interface SafetyRimeEngine : AutoCloseable {
+    fun processAscii(input: String): SafetyRimeEngineSnapshot
+
+    fun selectCandidate(index: Int): String
+}
+
+internal fun interface SafetyRimeEngineFactory {
+    fun open(rootDirectory: File): SafetyRimeEngine
+}
+
+internal fun interface SafetyRimeRootFactory {
+    fun create(editorGeneration: Long): SafetyRimeEphemeralRoot
+}
+
+internal class SafetyRimeEphemeralRoot(
+    val authorizedParent: File,
+    val directory: File,
+)
+
+private class AdapterRimeEngineFactory(
+    private val context: Context,
+) : SafetyRimeEngineFactory {
+    override fun open(rootDirectory: File): SafetyRimeEngine {
+        val adapter = RimeAdapter.open(context, rootDirectory)
+        return try {
+            AdapterRimeEngine(adapter, adapter.createSession())
+        } catch (failure: Exception) {
+            adapter.close()
+            throw failure
+        }
+    }
+}
+
+private class AdapterRimeEngine(
+    private val adapter: RimeAdapter,
+    private val session: Long,
+) : SafetyRimeEngine {
+    private var closed = false
+
+    override fun processAscii(input: String): SafetyRimeEngineSnapshot {
+        check(!closed) { "Rime engine is closed" }
+        val snapshot = adapter.processAscii(session, input)
+        return SafetyRimeEngineSnapshot(snapshot.preedit(), snapshot.candidates())
+    }
+
+    override fun selectCandidate(index: Int): String {
+        check(!closed) { "Rime engine is closed" }
+        return adapter.selectCandidate(session, index)
+    }
+
+    override fun close() {
+        if (!closed) {
+            closed = true
+            try {
+                adapter.destroySession(session)
+            } finally {
+                adapter.close()
+            }
+        }
+    }
+}
+
+private class NoBackupRimeRootFactory(
+    private val noBackupRoot: File,
+) : SafetyRimeRootFactory {
+    override fun create(editorGeneration: Long): SafetyRimeEphemeralRoot =
+        createNoBackupEphemeralRoot(noBackupRoot, editorGeneration)
+}
+
+internal fun createNoBackupEphemeralRoot(
+    noBackupRoot: File,
+    editorGeneration: Long,
+): SafetyRimeEphemeralRoot {
+    require(editorGeneration > 0L) { "editorGeneration must be positive" }
+    val noBackupPath = noBackupRoot.toPath().toAbsolutePath().normalize()
+    val parent = noBackupPath.resolve(RIME_EPHEMERAL_PARENT)
+    Files.createDirectories(parent)
+    if (!Files.isDirectory(parent) || Files.isSymbolicLink(parent)) {
+        throw IOException("Rime ephemeral parent is not a private directory")
+    }
+
+    var staleCount = 0
+    Files.newDirectoryStream(parent).use { entries ->
+        for (entry in entries) {
+            if (!entry.fileName.toString().startsWith(RIME_SESSION_PREFIX)) continue
+            staleCount += 1
+            if (staleCount > MAX_STALE_SESSION_ROOTS) {
+                throw IOException("Too many stale Rime session roots")
+            }
+            deleteEphemeralRoot(
+                SafetyRimeEphemeralRoot(parent.toFile(), entry.toFile()),
+            )
+        }
+    }
+
+    val root = parent.resolve(
+        "$RIME_SESSION_PREFIX$editorGeneration-${UUID.randomUUID()}",
+    ).normalize()
+    requireAuthorizedRoot(parent, root)
+    Files.createDirectory(root)
+    return SafetyRimeEphemeralRoot(parent.toFile(), root.toFile())
+}
+
+internal fun deleteEphemeralRoot(root: SafetyRimeEphemeralRoot) {
+    val parent = root.authorizedParent.toPath().toAbsolutePath().normalize()
+    val target = root.directory.toPath().toAbsolutePath().normalize()
+    requireAuthorizedRoot(parent, target)
+    if (!Files.exists(target, java.nio.file.LinkOption.NOFOLLOW_LINKS)) return
+
+    Files.walkFileTree(target, object : SimpleFileVisitor<Path>() {
+        override fun visitFile(file: Path, attrs: BasicFileAttributes): FileVisitResult {
+            Files.delete(file)
+            return FileVisitResult.CONTINUE
+        }
+
+        override fun postVisitDirectory(directory: Path, failure: IOException?): FileVisitResult {
+            failure?.let { throw it }
+            Files.delete(directory)
+            return FileVisitResult.CONTINUE
+        }
+    })
+}
+
+private fun requireAuthorizedRoot(parent: Path, target: Path) {
+    if (target.parent != parent || !target.fileName.toString().startsWith(RIME_SESSION_PREFIX)) {
+        throw IOException("Refusing to operate outside the Rime ephemeral session boundary")
+    }
+}
+
+private fun requireGeneration(value: Long) {
+    require(value > 0L) { "editorGeneration must be positive" }
+}
+
+private fun requireBoundedRimeText(value: String, allowEmpty: Boolean) {
+    require(allowEmpty || value.isNotEmpty()) { "Rime text must not be empty" }
+    require(value.length <= MAX_RIME_UTF16_UNITS) {
+        "Rime text exceeds $MAX_RIME_UTF16_UNITS UTF-16 units"
+    }
+    require(value.codePointCount(0, value.length) <= MAX_RIME_CODE_POINTS) {
+        "Rime text exceeds $MAX_RIME_CODE_POINTS code points"
+    }
+}
+
+private class InvalidRimeOutputException : Exception()
+
+private const val MAX_RIME_CODE_POINTS = 256
+private const val MAX_RIME_UTF16_UNITS = 512
+private const val MAX_RIME_CANDIDATES = 16
+private const val MAX_STALE_SESSION_ROOTS = 64
+private const val RIME_EPHEMERAL_PARENT = "route-a-safety-rime"
+private const val RIME_SESSION_PREFIX = "session-"
