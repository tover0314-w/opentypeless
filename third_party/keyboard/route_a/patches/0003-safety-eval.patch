+def _strip_comments(source: str) -> str:
+    """Remove Java/Kotlin comments while leaving strings visible to capability scans."""
+
+    output: list[str] = []
+    index = 0
+    state = "code"
+    quote = ""
+    while index < len(source):
+        current = source[index]
+        next_value = source[index + 1] if index + 1 < len(source) else ""
+        if state == "code":
+            if current == "/" and next_value == "/":
+                output.extend("  ")
+                index += 2
+                state = "line_comment"
+                continue
+            if current == "/" and next_value == "*":
+                output.extend("  ")
+                index += 2
+                state = "block_comment"
+                continue
+            if current in {'"', "'"}:
+                quote = current
+                state = "string"
+            output.append(current)
+            index += 1
+            continue
+        if state == "line_comment":
+            if current == "\n":
+                output.append("\n")
+                state = "code"
+            else:
+                output.append(" ")
+            index += 1
+            continue
+        if state == "block_comment":
+            if current == "*" and next_value == "/":
+                output.extend("  ")
+                index += 2
+                state = "code"
+            else:
+                output.append("\n" if current == "\n" else " ")
+                index += 1
+            continue
+        output.append(current)
+        if current == "\\" and index + 1 < len(source):
+            output.append(source[index + 1])
+            index += 2
+            continue
+        if current == quote:
+            state = "code"
+        index += 1
+    return "".join(output)
+
+
+def _production_sources(module_root: Path) -> list[Path]:
+    result: list[Path] = []
+    for path in module_root.rglob("*"):
+        if not path.is_file() or path.suffix not in _SOURCE_SUFFIXES:
+            continue
+        relative = path.relative_to(module_root)
+        if any(part in _EXCLUDED_SOURCE_PARTS for part in relative.parts):
+            continue
+        result.append(path)
+    return sorted(result)
+
+
+def _build_files(module_root: Path) -> list[Path]:
+    return sorted(
+        path
+        for path in module_root.rglob("*")
+        if path.is_file()
+        and path.name in _BUILD_FILE_NAMES
+        and "build" not in path.relative_to(module_root).parts[:-1]
+        and ".gradle" not in path.relative_to(module_root).parts
+    )
+
+
+def _producer_forbidden_tokens(text: str) -> list[str]:
+    """Return stable capability names, including unknown Manager/Registry types."""
+
+    forbidden = {token for token in PRODUCER_FORBIDDEN_TOKENS if token in text}
+    forbidden.update(_PRODUCER_MANAGER_REGISTRY_RE.findall(text))
+    return sorted(forbidden)
+
