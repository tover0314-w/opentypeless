+
+class SafetyRimeControllerTest {
+    @Test
+    fun keysAreCumulativeAndCandidateSelectionEmitsBoundedCommit() = runBlocking {
+        val fixture = Fixture()
+        val engine = RecordingEngine()
+        val outputs = Channel<SafetyRimeOutput>(capacity = 4)
+        val controller = fixture.controller(engine) { outputs.trySend(it).getOrThrow() }
+
+        try {
+            assertEquals(
+                SafetyRimeEnqueueResult.QUEUED,
+                controller.processKey('n', TEST_GENERATION),
+            )
+            val first = assertIs<SafetyRimeOutput.Composition>(outputs.receiveBounded())
+            assertEquals("n", first.preedit)
+            assertTrue(first.candidates.isEmpty())
+
+            assertEquals(
+                SafetyRimeEnqueueResult.QUEUED,
+                controller.processKey('i', TEST_GENERATION),
+            )
+            val second = assertIs<SafetyRimeOutput.Composition>(outputs.receiveBounded())
+            assertEquals("ni", second.preedit)
+            assertEquals(listOf("甲", "乙"), second.candidates)
+            assertFailsWith<UnsupportedOperationException> {
+                (second.candidates as MutableList<String>).add("丙")
+            }
+
+            assertEquals(
+                SafetyRimeEnqueueResult.QUEUED,
+                controller.selectCandidate(1, "乙", TEST_GENERATION),
+            )
+            val commit = assertIs<SafetyRimeOutput.Commit>(outputs.receiveBounded())
+            assertEquals("乙", commit.text)
+            assertEquals(listOf("n", "ni"), engine.inputs)
+            assertEquals(listOf(1), engine.selectedIndexes)
+            assertFalse(second.toString().contains("甲"))
+            assertFalse(commit.toString().contains("乙"))
+        } finally {
+            controller.close()
+            controller.awaitClosedForTest()
+            assertTrue(engine.closed)
+            fixture.close()
+        }
+    }
+
+    @Test
+    fun queuedKeyInvalidatesThePreviouslyDisplayedCandidateBeforeNativeSelect() = runBlocking {
+        val worker = ManualDispatcher()
+        val fixture = Fixture(workerDispatcher = worker)
+        val engine = ChangingPageEngine()
+        val outputs = Channel<SafetyRimeOutput>(capacity = 4)
+        val controller = fixture.controller(engine) { outputs.trySend(it).getOrThrow() }
+
+        try {
+            worker.runUntilIdle()
+            assertEquals(
+                SafetyRimeEnqueueResult.QUEUED,
+                controller.processKey('n', TEST_GENERATION),
+            )
+            worker.runUntilIdle()
+            val first = assertIs<SafetyRimeOutput.Composition>(outputs.receiveBounded())
+            assertEquals(listOf("甲"), first.candidates)
+
+            assertEquals(
+                SafetyRimeEnqueueResult.QUEUED,
+                controller.processKey('i', TEST_GENERATION),
+            )
+            assertEquals(
+                SafetyRimeEnqueueResult.QUEUED,
+                controller.selectCandidate(0, "甲", TEST_GENERATION),
+            )
+            worker.runUntilIdle()
+
+            val second = assertIs<SafetyRimeOutput.Composition>(outputs.receiveBounded())
+            assertEquals(listOf("乙"), second.candidates)
+            val failure = assertIs<SafetyRimeOutput.Failure>(outputs.receiveBounded())
+            assertEquals(SafetyRimeFailureKind.INVALID_OUTPUT, failure.kind)
+            assertTrue(engine.selectedIndexes.isEmpty())
+            assertTrue(outputs.tryReceive().isFailure)
+        } finally {
+            controller.close()
+            worker.runUntilIdle()
+            controller.awaitClosedForTest()
+            fixture.close()
+        }
+    }
+
+    @Test
+    fun staleGenerationAndSensitiveCloseFailClosed() = runBlocking {
+        val fixture = Fixture()
+        val engine = RecordingEngine()
+        val outputs = Channel<SafetyRimeOutput>(capacity = 2)
+        val controller = fixture.controller(engine) { outputs.trySend(it).getOrThrow() }
+
+        try {
+            assertEquals(
+                SafetyRimeEnqueueResult.STALE_GENERATION,
+                controller.processKey('n', TEST_GENERATION + 1L),
+            )
+            assertTrue(engine.inputs.isEmpty())
+            assertTrue(outputs.tryReceive().isFailure)
+
+            controller.closeForSensitiveField()
+            assertEquals(
+                SafetyRimeEnqueueResult.CLOSED,
+                controller.processKey('n', TEST_GENERATION),
+            )
+            controller.awaitClosedForTest()
+            assertTrue(outputs.tryReceive().isFailure)
+            assertFalse(fixture.sessionRoot.directory.exists())
+        } finally {
+            controller.close()
+            controller.awaitClosedForTest()
+            fixture.close()
+        }
+    }
+
+    @Test
+    fun cancellationDuringNativeWorkSuppressesLateOutputAndCleansStorage() = runBlocking {
+        val fixture = Fixture(workerDispatcher = Dispatchers.Default)
+        val engine = BlockingEngine()
+        val outputs = Channel<SafetyRimeOutput>(capacity = 2)
+        val controller = fixture.controller(engine) { outputs.trySend(it).getOrThrow() }
+
+        try {
+            assertEquals(
+                SafetyRimeEnqueueResult.QUEUED,
+                controller.processKey('n', TEST_GENERATION),
+            )
+            withTimeout(TEST_TIMEOUT_MILLIS) { engine.started.await() }
+            controller.close()
+            engine.release.countDown()
+            withTimeout(TEST_TIMEOUT_MILLIS) { controller.awaitClosedForTest() }
+
+            assertTrue(outputs.tryReceive().isFailure)
+            assertTrue(engine.closed)
+            assertFalse(fixture.sessionRoot.directory.exists())
+        } finally {
+            engine.release.countDown()
+            controller.close()
+            controller.awaitClosedForTest()
+            fixture.close()
+        }
+    }
+
+    @Test
+    fun oversizedNativeOutputIsClassifiedWithoutPlaintextDiagnostics() = runBlocking {
+        val fixture = Fixture()
+        val engine = RecordingEngine(
+            snapshot = SafetyRimeEngineSnapshot("ni", List(17) { "候选$it" }),
+        )
+        val outputs = Channel<SafetyRimeOutput>(capacity = 2)
+        val controller = fixture.controller(engine) { outputs.trySend(it).getOrThrow() }
+
+        try {
+            assertEquals(
+                SafetyRimeEnqueueResult.QUEUED,
+                controller.processKey('n', TEST_GENERATION),
+            )
+            val failure = assertIs<SafetyRimeOutput.Failure>(outputs.receiveBounded())
+            assertEquals(SafetyRimeFailureKind.INVALID_OUTPUT, failure.kind)
+            withTimeout(TEST_TIMEOUT_MILLIS) { controller.awaitClosedForTest() }
+            assertEquals(
+                SafetyRimeEnqueueResult.CLOSED,
+                controller.processKey('i', TEST_GENERATION),
+            )
+            assertFalse(failure.toString().contains("候选"))
+        } finally {
+            controller.close()
+            controller.awaitClosedForTest()
+            fixture.close()
+        }
+    }
+
+    @Test
+    fun cleanupRefusesTargetsOutsideAuthorizedSessionBoundary() {
+        val base = Files.createTempDirectory("route-a-rime-boundary-")
+        val authorizedParent = Files.createDirectory(base.resolve("authorized"))
+        val outside = Files.createDirectory(base.resolve("outside"))
+        try {
+            assertFailsWith<java.io.IOException> {
+                deleteEphemeralRoot(
+                    SafetyRimeEphemeralRoot(authorizedParent.toFile(), outside.toFile()),
+                )
+            }
+            assertTrue(Files.exists(outside))
+        } finally {
+            Files.deleteIfExists(outside)
+            Files.deleteIfExists(authorizedParent)
+            Files.deleteIfExists(base)
+        }
+    }
+
+    @Test
+    fun nextSessionSweepsOnlyBoundedStaleSessionRoots() {
+        val base = Files.createTempDirectory("route-a-rime-sweep-")
+        val parent = Files.createDirectories(base.resolve("route-a-safety-rime"))
+        val stale = Files.createDirectory(parent.resolve("session-stale"))
+        Files.write(stale.resolve("ephemeral.txt"), "synthetic".toByteArray())
+        val unrelated = Files.createDirectory(parent.resolve("keep"))
+
+        val fresh = createNoBackupEphemeralRoot(base.toFile(), TEST_GENERATION)
+        try {
+            assertFalse(Files.exists(stale))
+            assertTrue(Files.exists(unrelated))
+            assertTrue(fresh.directory.isDirectory)
+        } finally {
+            deleteEphemeralRoot(fresh)
+            Files.deleteIfExists(unrelated)
+            Files.deleteIfExists(parent)
+            Files.deleteIfExists(base)
+        }
+    }
+
+    private suspend fun Channel<SafetyRimeOutput>.receiveBounded(): SafetyRimeOutput =
+        withTimeout(TEST_TIMEOUT_MILLIS) { receive() }
+
+    private class Fixture(
+        private val workerDispatcher: kotlinx.coroutines.CoroutineDispatcher = Dispatchers.Unconfined,
+    ) {
+        private val base = Files.createTempDirectory("route-a-rime-controller-")
+        private val parentJob = SupervisorJob()
+        private val parentScope = CoroutineScope(Dispatchers.Unconfined + parentJob)
+        lateinit var sessionRoot: SafetyRimeEphemeralRoot
+            private set
+
+        fun controller(
+            engine: SafetyRimeEngine,
+            onOutput: (SafetyRimeOutput) -> Unit,
+        ): SafetyRimeController = SafetyRimeController.createForTest(
+            editorGeneration = TEST_GENERATION,
+            parentScope = parentScope,
+            workerDispatcher = workerDispatcher,
+            callbackDispatcher = Dispatchers.Unconfined,
+            rootFactory = SafetyRimeRootFactory { generation ->
+                createNoBackupEphemeralRoot(base.toFile(), generation).also { sessionRoot = it }
+            },
+            engineFactory = SafetyRimeEngineFactory { engine },
+            onOutput = onOutput,
+        )
+
+        fun close() {
+            parentScope.cancel()
+            val parent = base.resolve("route-a-safety-rime")
+            Files.deleteIfExists(parent)
+            Files.deleteIfExists(base)
+        }
+    }
+
+    private open class RecordingEngine(
+        private val snapshot: SafetyRimeEngineSnapshot =
+            SafetyRimeEngineSnapshot("ni", listOf("甲", "乙")),
+    ) : SafetyRimeEngine {
+        val inputs = mutableListOf<String>()
+        val selectedIndexes = mutableListOf<Int>()
+        var closed = false
+
+        override fun processAscii(input: String): SafetyRimeEngineSnapshot {
+            inputs += input
+            return if (input == "n" && snapshot.candidates == listOf("甲", "乙")) {
+                SafetyRimeEngineSnapshot("n", emptyList())
+            } else {
+                snapshot
+            }
+        }
+
+        override fun selectCandidate(index: Int): String {
+            selectedIndexes += index
+            return listOf("甲", "乙")[index]
+        }
+
+        override fun close() {
+            closed = true
+        }
+    }
+
+    private class BlockingEngine : SafetyRimeEngine {
+        val started = CompletableDeferred<Unit>()
+        val release = CountDownLatch(1)
+        var closed = false
+
+        override fun processAscii(input: String): SafetyRimeEngineSnapshot {
+            started.complete(Unit)
+            release.await()
+            return SafetyRimeEngineSnapshot("n", emptyList())
+        }
+
+        override fun selectCandidate(index: Int): String = error("not used")
+
+        override fun close() {
+            closed = true
+        }
+    }
+
+    private class ChangingPageEngine : SafetyRimeEngine {
+        val selectedIndexes = mutableListOf<Int>()
+
+        override fun processAscii(input: String): SafetyRimeEngineSnapshot = when (input) {
+            "n" -> SafetyRimeEngineSnapshot("n", listOf("甲"))
+            "ni" -> SafetyRimeEngineSnapshot("ni", listOf("乙"))
+            else -> error("unexpected synthetic input")
+        }
+
+        override fun selectCandidate(index: Int): String {
+            selectedIndexes += index
+            return "乙"
+        }
+
+        override fun close() = Unit
+    }
+
+    private class ManualDispatcher : kotlinx.coroutines.CoroutineDispatcher() {
+        private val tasks = ArrayDeque<Runnable>()
+
+        override fun dispatch(context: CoroutineContext, block: Runnable) {
+            tasks.addLast(block)
+        }
+
+        fun runUntilIdle() {
+            var runs = 0
+            while (tasks.isNotEmpty()) {
+                check(runs++ < 100) { "manual dispatcher did not become idle" }
+                tasks.removeFirst().run()
+            }
+        }
+    }
+
+    private companion object {
+        const val TEST_GENERATION = 7L
+        const val TEST_TIMEOUT_MILLIS = 2_000L
+    }
+}
