+
+package com.opentypeless.routea.safety
+
+import android.content.Context
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.TextView
+
+/** Small real-View keyboard used only by the buildable Route-A safety artifact. */
+class SafetyTextKeyboardView(
+    context: Context,
+    private val editorGeneration: Long,
+    private val dispatcher: SafetyInputEventDispatcher,
+) : LinearLayout(context), SafetyRimeUiObserver {
+    private val preedit = TextView(context)
+    private val candidate = Button(context)
+    private val status = TextView(context)
+
+    init {
+        orientation = VERTICAL
+        gravity = Gravity.CENTER_HORIZONTAL
+        setPadding(dp(4), dp(4), dp(4), dp(4))
+
+        preedit.tag = TAG_RIME_PREEDIT
+        preedit.gravity = Gravity.CENTER
+        preedit.minHeight = dp(48)
+        addView(preedit, matchRow())
+
+        addRow(
+            key("a", "a", TAG_KEY_A) { SafetyShellIntent.Text("a") },
+            key("b", "b", TAG_KEY_B) { SafetyShellIntent.Text("b") },
+            key("c", "c", TAG_KEY_C) { SafetyShellIntent.Text("c") },
+        )
+        addRow(
+            key("n", "Rime n", TAG_RIME_N) {
+                SafetyShellIntent.RimeKey('n', editorGeneration)
+            },
+            key("i", "Rime i", TAG_RIME_I) {
+                SafetyShellIntent.RimeKey('i', editorGeneration)
+            },
+            key(resource(R.string.key_voice), resource(R.string.key_voice), TAG_VOICE) {
+                SafetyShellIntent.Voice(editorGeneration)
+            },
+        )
+        addRow(
+            key(resource(R.string.key_space), resource(R.string.key_space), TAG_SPACE) {
+                SafetyShellIntent.Space
+            },
+            key(resource(R.string.key_delete), resource(R.string.key_delete), TAG_DELETE) {
+                SafetyShellIntent.Delete
+            },
+            key(resource(R.string.key_enter), resource(R.string.key_enter), TAG_ENTER) {
+                SafetyShellIntent.Enter
+            },
+        )
+        addRow(
+            key(resource(R.string.key_undo), resource(R.string.key_undo), TAG_UNDO) {
+                SafetyShellIntent.Undo(editorGeneration)
+            },
+            key(
+                resource(R.string.key_quick_action_space),
+                resource(R.string.key_quick_action_space),
+                TAG_ACTION_SPACE,
+            ) {
+                SafetyShellIntent.QuickActionInsertText(" ", editorGeneration)
+            },
+            key(
+                resource(R.string.key_quick_action_text),
+                resource(R.string.key_quick_action_text),
+                TAG_ACTION_TEXT,
+            ) {
+                SafetyShellIntent.QuickActionInsertText("!", editorGeneration)
+            },
+        )
+
+        candidate.tag = TAG_RIME_CANDIDATE
+        candidate.contentDescription = resource(R.string.key_rime_candidate)
+        candidate.minHeight = dp(48)
+        candidate.isEnabled = false
+        candidate.visibility = View.INVISIBLE
+        candidate.setOnClickListener {
+            val value = candidate.text.toString()
+            if (value.isNotEmpty()) {
+                showResult(
+                    dispatcher.sendDownUp(
+                        SafetyShellIntent.RimeCandidate(value, editorGeneration),
+                    ),
+                )
+            }
+        }
+        addView(candidate, matchRow())
+
+        status.tag = TAG_STATUS
+        status.gravity = Gravity.CENTER
+        status.minHeight = dp(48)
+        status.text = resource(R.string.status_ready)
+        addView(status, matchRow())
+    }
+
+    override fun onComposition(preedit: String, candidates: List<String>) {
+        this.preedit.text = preedit
+        val first = candidates.firstOrNull().orEmpty()
+        candidate.text = first
+        candidate.isEnabled = first.isNotEmpty()
+        candidate.visibility = if (first.isEmpty()) View.INVISIBLE else View.VISIBLE
+    }
+
+    override fun onTerminal(result: SafetyDispatchResult) {
+        showResult(result)
+    }
+
+    override fun onFailure(kind: SafetyRimeFailureKind) {
+        status.text = resource(R.string.status_rime_failed)
+        status.contentDescription = kind.name
+    }
+
+    fun close() {
+        dispatcher.close()
+        onComposition("", emptyList())
+    }
+
+    private fun key(
+        label: String,
+        description: String,
+        testTag: String,
+        intent: () -> SafetyShellIntent,
+    ): Button = Button(context).apply {
+        text = label
+        contentDescription = description
+        tag = testTag
+        minWidth = dp(48)
+        minHeight = dp(48)
+        setOnClickListener { showResult(dispatcher.sendDownUp(intent())) }
+    }
+
+    private fun addRow(vararg keys: Button) {
+        val row = LinearLayout(context).apply {
+            orientation = HORIZONTAL
+            gravity = Gravity.CENTER
+        }
+        keys.forEach { row.addView(it, LayoutParams(0, dp(56), 1f)) }
+        addView(row, matchRow())
+    }
+
+    private fun showResult(result: SafetyDispatchResult) {
+        status.text = resource(
+            when (result) {
+                SafetyDispatchResult.Accepted -> R.string.status_applied
+                is SafetyDispatchResult.Rejected -> R.string.status_rejected
+                SafetyDispatchResult.TargetChanged -> R.string.status_target_changed
+            },
+        )
+    }
+
+    private fun resource(id: Int): String = context.getString(id)
+
+    private fun dp(value: Int): Int =
+        (value * resources.displayMetrics.density).toInt().coerceAtLeast(value)
+
+    private fun matchRow(): ViewGroup.LayoutParams =
+        LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT)
+
+    companion object {
+        const val TAG_KEY_A = "safety-key-a"
+        const val TAG_KEY_B = "safety-key-b"
+        const val TAG_KEY_C = "safety-key-c"
+        const val TAG_SPACE = "safety-space"
+        const val TAG_DELETE = "safety-delete"
+        const val TAG_ENTER = "safety-enter"
+        const val TAG_VOICE = "safety-voice"
+        const val TAG_UNDO = "safety-undo"
+        const val TAG_ACTION_SPACE = "safety-action-space"
+        const val TAG_ACTION_TEXT = "safety-action-text"
+        const val TAG_RIME_N = "safety-rime-n"
+        const val TAG_RIME_I = "safety-rime-i"
+        const val TAG_RIME_CANDIDATE = "safety-rime-candidate"
+        const val TAG_RIME_PREEDIT = "safety-rime-preedit"
+        const val TAG_STATUS = "safety-status"
+    }
+}
