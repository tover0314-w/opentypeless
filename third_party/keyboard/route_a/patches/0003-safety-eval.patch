+/*
+ * Copyright (C) 2026 OpenTypeless Contributors
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ */
+
+package com.opentypeless.routea.safety
+
+enum class SafetyWriterRoute {
+    SAFETY,
+    LEGACY,
+}
+
+/** Capability-free legacy spy used only to prove mutually exclusive evaluation routing. */
+fun interface LegacyEvaluationSink {
+    fun dispatch(intent: SafetyShellIntent): SafetyDispatchResult
+}
+
+/**
+ * Immutable, per-session writer selection.
+ *
+ * Exactly one sink is accepted at construction. Dispatch invokes that sink once and returns or
+ * throws exactly what it returned or threw; rejection, target change, and exceptions never cause
+ * a second-route fallback.
+ */
+class ExclusiveWriterRoute private constructor(
+    val sessionId: Long,
+    val selectedRoute: SafetyWriterRoute,
+    private val selectedSink: SafetyEditorSink,
+) : SafetyEditorSink {
+    override fun dispatch(intent: SafetyShellIntent): SafetyDispatchResult =
+        selectedSink.dispatch(intent)
+
+    companion object {
+        fun bindForSession(
+            sessionId: Long,
+            selectedRoute: SafetyWriterRoute,
+            safetySink: SafetyEditorSink?,
+            legacyFakeSink: LegacyEvaluationSink?,
+        ): ExclusiveWriterRoute {
+            require(sessionId > 0L) { "sessionId must be positive" }
+            val selectedSink = when (selectedRoute) {
+                SafetyWriterRoute.SAFETY -> {
+                    require(legacyFakeSink == null) {
+                        "SAFETY requires exactly one safety sink"
+                    }
+                    requireNotNull(safetySink) { "SAFETY requires exactly one safety sink" }
+                }
+
+                SafetyWriterRoute.LEGACY -> {
+                    require(safetySink == null) {
+                        "LEGACY requires exactly one capability-free legacy fake sink"
+                    }
+                    val fake = requireNotNull(legacyFakeSink) {
+                        "LEGACY requires exactly one capability-free legacy fake sink"
+                    }
+                    SafetyEditorSink { intent -> fake.dispatch(intent) }
+                }
+            }
+            return ExclusiveWriterRoute(sessionId, selectedRoute, selectedSink)
+        }
+    }
+}
diff --git a/route-a-safety-eval/src/main/kotlin/com/opentypeless/routea/safety/PortSafetyEditorSink.kt b/route-a-safety-eval/src/main/kotlin/com/opentypeless/routea/safety/PortSafetyEditorSink.kt
new file mode 100644
index 0000000..88d91f1
--- /dev/null
+++ b/route-a-safety-eval/src/main/kotlin/com/opentypeless/routea/safety/PortSafetyEditorSink.kt
@@ -0,0 +1,220 @@
+/*
+ * Copyright (C) 2026 OpenTypeless Contributors
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ */
+
+package com.opentypeless.routea.safety
+
+import com.opentypeless.android.editor.EditorTransactionResult
+import com.opentypeless.android.editor.host.EditorPort
+
+/** Content-free UI observer; plaintext is kept in the transient IME view only. */
+interface SafetyRimeUiObserver {
+    fun onComposition(preedit: String, candidates: List<String>)
+
+    fun onTerminal(result: SafetyDispatchResult)
+
+    fun onFailure(kind: SafetyRimeFailureKind)
+}
+
+/**
+ * The sole producer-side adapter to the capability-free [EditorPort].
+ *
+ * It never receives Android editor authority. Rime work is asynchronous and a native commit is
+ * delivered only after the exact input generation is rechecked on the owner thread.
+ */
+class PortSafetyEditorSink(
+    private val port: EditorPort,
+    private val editorGeneration: Long,
+    private val rime: SafetyRimeController?,
+    private val rimeUi: SafetyRimeUiObserver,
+) : SafetyEditorSink, AutoCloseable {
+    private var latestCandidates: List<String> = emptyList()
+    private var closed: Boolean = false
+
+    override fun dispatch(intent: SafetyShellIntent): SafetyDispatchResult {
+        if (closed) return rejected(SafetyRejectionReason.DISPATCHER_CLOSED)
+        if (!port.isCurrentGeneration(editorGeneration)) {
+            return SafetyDispatchResult.TargetChanged
+        }
+        return when (intent) {
+            is SafetyShellIntent.Text -> withoutRime { map(port.insertLatin(intent.text)) }
+            SafetyShellIntent.Space -> withoutRime { map(port.insertLatin(" ")) }
+            SafetyShellIntent.Delete -> withoutRime { map(port.deleteBackward()) }
+            SafetyShellIntent.Enter -> withoutRime { map(port.performEnter()) }
+            is SafetyShellIntent.RimeKey -> processRimeKey(intent)
+            is SafetyShellIntent.RimeCandidate -> selectRimeCandidate(intent)
+            is SafetyShellIntent.Voice -> withoutRime { advanceVoice(intent.editorGeneration) }
+            is SafetyShellIntent.Undo -> withoutRime { undoVoice(intent.editorGeneration) }
+            is SafetyShellIntent.QuickActionInsertText -> withoutRime { insertAction(intent) }
+            is SafetyShellIntent.QuickActionInsertKey ->
+                rejected(SafetyRejectionReason.UNSUPPORTED_INPUT)
+        }
+    }
+
+    fun onRimeOutput(output: SafetyRimeOutput) {
+        if (closed || output.editorGeneration != editorGeneration) return
+        if (!port.isCurrentGeneration(editorGeneration)) {
+            cancelRimeInteraction(closeController = true)
+            return
+        }
+        when (output) {
+            is SafetyRimeOutput.Composition -> {
+                if (!requireCurrentRimeTarget()) return
+                latestCandidates = output.candidates.toList()
+                rimeUi.onComposition(output.preedit, latestCandidates)
+            }
+
+            is SafetyRimeOutput.Commit -> {
+                if (!requireCurrentRimeTarget()) return
+                latestCandidates = emptyList()
+                rimeUi.onComposition("", emptyList())
+                rimeUi.onTerminal(map(port.insertRime(editorGeneration, output.text)))
+            }
+
+            is SafetyRimeOutput.Failure -> {
+                cancelRimeInteraction(closeController = false)
+                rimeUi.onFailure(output.kind)
+            }
+        }
+    }
+
+    private fun requireCurrentRimeTarget(): Boolean {
+        if (port.rimeTargetStillCurrent(editorGeneration)) return true
+        cancelRimeInteraction(closeController = true)
+        rimeUi.onTerminal(SafetyDispatchResult.TargetChanged)
+        return false
+    }
+
+    override fun close() {
+        if (closed) return
+        closed = true
+        cancelRimeInteraction(closeController = true)
+    }
+
+    private fun processRimeKey(intent: SafetyShellIntent.RimeKey): SafetyDispatchResult {
+        if (!isCurrent(intent.editorGeneration)) return SafetyDispatchResult.TargetChanged
+        val controller = rime
+            ?: return rejected(SafetyRejectionReason.POLICY_DENIED)
+        if (!port.allowsPlaintextProcessing()) {
+            controller.closeForSensitiveField()
+            cancelRimeInteraction(closeController = false)
+            return rejected(SafetyRejectionReason.POLICY_DENIED)
+        }
+        if (!port.allowsRimeProcessing()) {
+            controller.closeForSensitiveField()
+            cancelRimeInteraction(closeController = false)
+            return rejected(SafetyRejectionReason.POLICY_DENIED)
+        }
+        if (!port.prepareRimeTarget(intent.editorGeneration)) {
+            controller.close()
+            return SafetyDispatchResult.TargetChanged
+        }
+        return mapRimeEnqueue(
+            controller.processKey(intent.key, intent.editorGeneration),
+        )
+    }
+
+    private fun selectRimeCandidate(
+        intent: SafetyShellIntent.RimeCandidate,
+    ): SafetyDispatchResult {
+        if (!isCurrent(intent.editorGeneration)) return SafetyDispatchResult.TargetChanged
+        val controller = rime
+            ?: return rejected(SafetyRejectionReason.POLICY_DENIED)
+        if (!port.allowsPlaintextProcessing()) {
+            controller.closeForSensitiveField()
+            cancelRimeInteraction(closeController = false)
+            return rejected(SafetyRejectionReason.POLICY_DENIED)
+        }
+        if (!port.allowsRimeProcessing()) {
+            controller.closeForSensitiveField()
+            cancelRimeInteraction(closeController = false)
+            return rejected(SafetyRejectionReason.POLICY_DENIED)
+        }
+        if (!port.prepareRimeTarget(intent.editorGeneration)) {
+            controller.close()
+            return SafetyDispatchResult.TargetChanged
+        }
+        val index = latestCandidates.indexOf(intent.text)
+        if (index !in 0..15) {
+            cancelRimeInteraction(closeController = true)
+            return rejected(SafetyRejectionReason.UNSUPPORTED_INPUT)
+        }
+        return mapRimeEnqueue(
+            controller.selectCandidate(
+                index = index,
+                expectedCandidate = intent.text,
+                editorGeneration = intent.editorGeneration,
+            ),
+        )
+    }
+
+    private inline fun withoutRime(block: () -> SafetyDispatchResult): SafetyDispatchResult {
+        cancelRimeInteraction(closeController = true, onlyIfTarget = true)
+        return block()
+    }
+
+    private fun cancelRimeInteraction(
+        closeController: Boolean,
+        onlyIfTarget: Boolean = false,
+    ) {
+        latestCandidates = emptyList()
+        val hadTarget = port.cancelRimeTarget(editorGeneration)
+        if (closeController && (!onlyIfTarget || hadTarget)) rime?.close()
+        rimeUi.onComposition("", emptyList())
+    }
+
+    private fun advanceVoice(generation: Long): SafetyDispatchResult {
+        if (!isCurrent(generation)) return SafetyDispatchResult.TargetChanged
+        if (!port.allowsPlaintextProcessing()) {
+            return rejected(SafetyRejectionReason.POLICY_DENIED)
+        }
+        return map(port.advanceVoice().result())
+    }
+
+    private fun undoVoice(generation: Long): SafetyDispatchResult {
+        if (!isCurrent(generation)) return SafetyDispatchResult.TargetChanged
+        return map(port.undoVoice().result())
+    }
+
+    private fun insertAction(
+        intent: SafetyShellIntent.QuickActionInsertText,
+    ): SafetyDispatchResult {
+        if (!isCurrent(intent.editorGeneration)) return SafetyDispatchResult.TargetChanged
+        if (!port.allowsPlaintextProcessing()) {
+            return rejected(SafetyRejectionReason.POLICY_DENIED)
+        }
+        return map(port.insertAction(intent.text))
+    }
+
+    private fun isCurrent(generation: Long): Boolean =
+        generation == editorGeneration && port.isCurrentGeneration(generation)
+
+    private fun mapRimeEnqueue(result: SafetyRimeEnqueueResult): SafetyDispatchResult {
+        if (result != SafetyRimeEnqueueResult.QUEUED) {
+            cancelRimeInteraction(closeController = true)
+        }
+        return map(result)
+    }
+
+    private fun map(result: SafetyRimeEnqueueResult): SafetyDispatchResult = when (result) {
+        SafetyRimeEnqueueResult.QUEUED -> SafetyDispatchResult.Accepted
+        SafetyRimeEnqueueResult.STALE_GENERATION -> SafetyDispatchResult.TargetChanged
+        SafetyRimeEnqueueResult.CLOSED -> rejected(SafetyRejectionReason.DISPATCHER_CLOSED)
+        SafetyRimeEnqueueResult.BACKPRESSURE ->
+            rejected(SafetyRejectionReason.INPUT_ALREADY_ACTIVE)
+    }
+
+    private fun map(result: EditorTransactionResult): SafetyDispatchResult = when (result) {
+        is EditorTransactionResult.Applied -> SafetyDispatchResult.Accepted
+        is EditorTransactionResult.TargetChanged -> SafetyDispatchResult.TargetChanged
+        is EditorTransactionResult.Rejected -> rejected(SafetyRejectionReason.POLICY_DENIED)
+        is EditorTransactionResult.RolledBack -> rejected(SafetyRejectionReason.POLICY_DENIED)
+        is EditorTransactionResult.RollbackFailed -> SafetyDispatchResult.TargetChanged
+    }
+
+    private fun rejected(reason: SafetyRejectionReason): SafetyDispatchResult.Rejected =
+        SafetyDispatchResult.Rejected(reason)
+}
