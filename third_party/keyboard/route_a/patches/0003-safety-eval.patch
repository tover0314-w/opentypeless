+    private class PlaintextSafetySession private constructor(
+        val view: SafetyTextKeyboardView,
+        val sink: PortSafetyEditorSink,
+        val observer: ForwardingRimeObserver,
+        private val dispatcher: SafetyInputEventDispatcher,
+        private val controller: SafetyRimeController?,
+        private val scope: CoroutineScope,
+    ) {
+        fun click(tag: String) = click(view, tag)
+
+        fun closeAndAwait() {
+            onMain {
+                view.close()
+                dispatcher.close()
+                sink.close()
+                scope.cancel()
+            }
+            controller?.let { runBlocking { it.awaitClosedForTest() } }
+        }
+
+        companion object {
+            fun create(
+                context: Context,
+                port: EditorPort,
+                rimeEnabled: Boolean = true,
+                controllerOverride: SafetyRimeController? = null,
+            ): PlaintextSafetySession {
+                val generation = port.generation()
+                val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+                val sinkRef = AtomicReference<PortSafetyEditorSink?>()
+                val pendingOutputs = ConcurrentLinkedQueue<SafetyRimeOutput>()
+                val observer = ForwardingRimeObserver()
+                val controller = controllerOverride ?: if (rimeEnabled) {
+                    SafetyRimeController(
+                        context = context,
+                        editorGeneration = generation,
+                        parentScope = scope,
+                        onOutput = { output ->
+                            val current = sinkRef.get()
+                            if (current != null) {
+                                current.onRimeOutput(output)
+                            } else {
+                                pendingOutputs.add(output)
+                                sinkRef.get()?.let { available ->
+                                    while (true) {
+                                        available.onRimeOutput(pendingOutputs.poll() ?: break)
+                                    }
+                                }
+                            }
+                        },
+                    )
+                } else {
+                    null
+                }
+                val sink = PortSafetyEditorSink(port, generation, controller, observer)
+                val route = ExclusiveWriterRoute.bindForSession(
+                    sessionId = generation,
+                    selectedRoute = SafetyWriterRoute.SAFETY,
+                    safetySink = sink,
+                    legacyFakeSink = null,
+                )
+                val dispatcher = SafetyShellRouter(route).newInputEventDispatcher()
+                val view = SafetyTextKeyboardView(context, generation, dispatcher)
+                observer.delegate.set(view)
+                sinkRef.set(sink)
+                while (true) {
+                    sink.onRimeOutput(pendingOutputs.poll() ?: break)
+                }
+                return PlaintextSafetySession(
+                    view = view,
+                    sink = sink,
+                    observer = observer,
+                    dispatcher = dispatcher,
+                    controller = controller,
+                    scope = scope,
+                )
+            }
+        }
+    }
+
+    private class ForwardingRimeObserver : SafetyRimeUiObserver {
+        val delegate = AtomicReference<SafetyRimeUiObserver?>()
+        val latestPreedit = AtomicReference("")
+        private val niCandidates = CountDownLatch(1)
+        private val terminal = CountDownLatch(1)
+        val latestTerminal = AtomicReference<SafetyDispatchResult?>()
+        private val failure = AtomicReference<SafetyRimeFailureKind?>()
+
+        override fun onComposition(preedit: String, candidates: List<String>) {
+            latestPreedit.set(preedit)
+            delegate.get()?.onComposition(preedit, candidates)
+            if (preedit == "ni" && candidates.isNotEmpty()) niCandidates.countDown()
+        }
+
+        override fun onTerminal(result: SafetyDispatchResult) {
+            latestTerminal.set(result)
+            delegate.get()?.onTerminal(result)
+            terminal.countDown()
+        }
+
+        override fun onFailure(kind: SafetyRimeFailureKind) {
+            failure.compareAndSet(null, kind)
+            delegate.get()?.onFailure(kind)
+        }
+
+        fun awaitNiCandidates(): Boolean =
+            niCandidates.await(RIME_TIMEOUT_SECONDS, TimeUnit.SECONDS) && failure.get() == null
+
+        fun awaitTerminal(): Boolean =
+            terminal.await(RIME_TIMEOUT_SECONDS, TimeUnit.SECONDS) &&
+                latestTerminal.get() is SafetyDispatchResult.Accepted && failure.get() == null
+
+        fun awaitAnyTerminal(): Boolean =
+            terminal.await(RIME_TIMEOUT_SECONDS, TimeUnit.SECONDS) && failure.get() == null
+    }
+
+    private class EditorHarness private constructor(
+        private val context: Context,
+        var info: EditorInfo,
+        var connection: ControlledInputConnection,
+    ) {
+        private val manager = EditorSessionManager()
+        private val host = object : EditorSessionManager.KeyboardHost {
+            override fun currentEditorInfo(): EditorInfo = info
+
+            override fun currentInputConnection(): InputConnection = connection
+        }
+        val port = EditorPort(manager, host)
+        private var active = false
+        private var closed = false
+
+        init {
+            startInput()
+        }
+
+        fun finishInput() {
+            check(!closed) { "editor harness is closed" }
+            if (!active) return
+            port.onFinishInput()
+            manager.onFinishInput()
+            active = false
+        }
+
+        fun startNewEditor(text: String, cursor: Int, fieldId: Int) {
+            check(!closed) { "editor harness is closed" }
+            check(!active) { "finish the current editor before starting another" }
+            info = editorInfo(context, cursor, fieldId, NORMAL_INPUT_TYPE)
+            connection = ControlledInputConnection(context, text, cursor, cursor)
+            startInput()
+        }
+
+        fun moveSelection(cursor: Int, notifyManager: Boolean) {
+            connection.moveSelection(cursor)
+            if (notifyManager) manager.onSelectionChanged(cursor, cursor)
+        }
+
+        fun mutateInputTypeWithoutLifecycle(inputType: Int) {
+            info.inputType = inputType
+        }
+
+        fun close() {
+            if (closed) return
+            finishInput()
+            closed = true
+            port.close()
+            manager.close()
+        }
+
+        private fun startInput() {
+            manager.onStartInput(info, connection)
+            port.onStartInput()
+            active = true
+        }
+
+        companion object {
+            fun normal(context: Context, text: String, cursor: Int): EditorHarness =
+                create(context, text, cursor, NORMAL_INPUT_TYPE)
+
+            fun sensitive(context: Context, text: String, cursor: Int): EditorHarness =
+                create(context, text, cursor, SENSITIVE_INPUT_TYPE)
+
+            fun noLearning(context: Context, text: String, cursor: Int): EditorHarness =
+                create(
+                    context,
+                    text,
+                    cursor,
+                    NORMAL_INPUT_TYPE,
+                    EditorInfo.IME_FLAG_NO_PERSONALIZED_LEARNING,
+                )
+
+            fun actionSend(context: Context, text: String, cursor: Int): EditorHarness =
+                create(
+                    context,
+                    text,
+                    cursor,
+                    NORMAL_INPUT_TYPE,
+                    EditorInfo.IME_ACTION_SEND,
+                )
+
+            fun restrictedAssistive(
+                context: Context,
+                text: String,
+                cursor: Int,
+                inputType: Int,
+            ): EditorHarness = create(context, text, cursor, inputType)
+
+            private fun create(
+                context: Context,
+                text: String,
+                cursor: Int,
+                inputType: Int,
+                imeOptions: Int = EditorInfo.IME_ACTION_NONE,
+            ): EditorHarness = EditorHarness(
+                context = context,
+                info = editorInfo(
+                    context,
+                    cursor,
+                    fieldId = 41,
+                    inputType = inputType,
+                    imeOptions = imeOptions,
+                ),
+                connection = ControlledInputConnection(context, text, cursor, cursor),
+            )
+
+            private fun editorInfo(
+                context: Context,
+                cursor: Int,
+                fieldId: Int,
+                inputType: Int,
+                imeOptions: Int = EditorInfo.IME_ACTION_NONE,
+            ): EditorInfo = EditorInfo().apply {
+                packageName = context.packageName
+                this.fieldId = fieldId
+                this.inputType = inputType
+                this.imeOptions = imeOptions
+                initialSelStart = cursor
+                initialSelEnd = cursor
+            }
+        }
+    }
+
+    private class ControlledInputConnection(
+        context: Context,
+        text: String,
+        selectionStart: Int,
+        selectionEnd: Int,
+    ) : BaseInputConnection(View(context), true) {
+        private val editable: Editable = SpannableStringBuilder(text).also {
+            Selection.setSelection(it, selectionStart, selectionEnd)
+        }
+        private var insideFrameworkMutator = false
+
+        var beginCalls = 0
+            private set
+        var endCalls = 0
+            private set
+        var commitCalls = 0
+            private set
+        var deleteCalls = 0
+            private set
+        var setCompositionCalls = 0
+            private set
+        var finishCompositionCalls = 0
+            private set
+        var performEditorActionCalls = 0
+            private set
+        var plaintextGetterCalls = 0
+            private set
+        var extractedTextCalls = 0
+            private set
+
+        override fun getEditable(): Editable = editable
+
+        override fun beginBatchEdit(): Boolean {
+            if (!insideFrameworkMutator) beginCalls += 1
+            return true
+        }
+
+        override fun endBatchEdit(): Boolean {
+            if (!insideFrameworkMutator) endCalls += 1
+            return true
+        }
+
+        override fun commitText(text: CharSequence?, newCursorPosition: Int): Boolean {
+            commitCalls += 1
+            return insideMutation { super.commitText(text, newCursorPosition) }
+        }
+
+        override fun deleteSurroundingTextInCodePoints(
+            beforeLength: Int,
+            afterLength: Int,
+        ): Boolean {
+            deleteCalls += 1
+            return insideMutation {
+                super.deleteSurroundingTextInCodePoints(beforeLength, afterLength)
+            }
+        }
+
+        override fun setComposingText(text: CharSequence?, newCursorPosition: Int): Boolean {
+            setCompositionCalls += 1
+            return insideMutation { super.setComposingText(text, newCursorPosition) }
+        }
+
+        override fun finishComposingText(): Boolean {
+            finishCompositionCalls += 1
+            return insideMutation { super.finishComposingText() }
+        }
+
+        override fun performEditorAction(actionCode: Int): Boolean {
+            performEditorActionCalls += 1
+            return true
+        }
+
+        override fun getSelectedText(flags: Int): CharSequence? {
+            plaintextGetterCalls += 1
+            return super.getSelectedText(flags)
+        }
+
+        override fun getTextBeforeCursor(length: Int, flags: Int): CharSequence? {
+            plaintextGetterCalls += 1
+            return super.getTextBeforeCursor(length, flags)
+        }
+
+        override fun getTextAfterCursor(length: Int, flags: Int): CharSequence? {
+            plaintextGetterCalls += 1
+            return super.getTextAfterCursor(length, flags)
+        }
+
+        override fun getExtractedText(
+            request: ExtractedTextRequest?,
+            flags: Int,
+        ): ExtractedText {
+            extractedTextCalls += 1
+            return ExtractedText().apply {
+                startOffset = 0
+                partialStartOffset = -1
+                partialEndOffset = -1
+                selectionStart = Selection.getSelectionStart(editable)
+                selectionEnd = Selection.getSelectionEnd(editable)
+            }
+        }
+
+        fun text(): String = editable.toString()
+
+        fun moveSelection(cursor: Int) {
+            Selection.setSelection(editable, cursor)
+        }
+
+        fun totalMutatorCalls(): Int =
+            commitCalls + deleteCalls + setCompositionCalls + finishCompositionCalls +
+                performEditorActionCalls
+
+        private inline fun insideMutation(block: () -> Boolean): Boolean {
+            insideFrameworkMutator = true
+            return try {
+                block()
+            } finally {
+                insideFrameworkMutator = false
+            }
+        }
+    }
+
+    private class PausedDispatcher : CoroutineDispatcher() {
+        private val pending = ArrayDeque<Runnable>()
+
+        override fun dispatch(context: CoroutineContext, block: Runnable) {
+            pending.addLast(block)
+        }
+
+        fun runUntilIdle() {
+            var runs = 0
+            while (pending.isNotEmpty()) {
+                check(runs++ < 100) { "paused dispatcher did not become idle" }
+                pending.removeFirst().run()
+            }
+        }
+    }
+
+    private class NoopRimeEngine : SafetyRimeEngine {
+        override fun processAscii(input: String): SafetyRimeEngineSnapshot =
+            SafetyRimeEngineSnapshot(input, emptyList())
+
+        override fun selectCandidate(index: Int): String = error("not used")
+
+        override fun close() = Unit
+    }
+
+    companion object {
+        private val NORMAL_INPUT_TYPE =
+            InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_NORMAL
+        private val SENSITIVE_INPUT_TYPE =
+            InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_PASSWORD
+        private val NUMERIC_ASSISTIVE_INPUT_TYPE =
+            InputType.TYPE_CLASS_NUMBER or InputType.TYPE_NUMBER_VARIATION_NORMAL
+        private val IDENTITY_ASSISTIVE_INPUT_TYPE =
+            InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_PERSON_NAME
+        private const val RIME_TIMEOUT_SECONDS = 30L
+        private const val RIME_EPHEMERAL_PARENT = "route-a-safety-rime"
+        private const val RIME_SESSION_PREFIX = "session-"
+
+        private fun targetContext(): Context =
+            InstrumentationRegistry.getInstrumentation().targetContext
+
+        private fun click(view: SafetyTextKeyboardView, tag: String) {
+            val target = view.findViewWithTag<View>(tag)
+            assertNotNull("missing real View for $tag", target)
+            assertTrue("real View did not handle $tag", target.performClick())
+        }
+
+        private fun onMain(block: () -> Unit) {
+            val instrumentation = InstrumentationRegistry.getInstrumentation()
+            var failure: Throwable? = null
+            instrumentation.runOnMainSync {
+                try {
+                    block()
+                } catch (caught: Throwable) {
+                    failure = caught
+                }
+            }
+            failure?.let { throw AssertionError("main-thread test failed", it) }
+        }
+
+        private fun <T> onMainValue(block: () -> T): T {
+            var value: T? = null
+            onMain { value = block() }
+            @Suppress("UNCHECKED_CAST")
+            return value as T
+        }
+    }
+}
