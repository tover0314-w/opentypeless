+        build_file.write_text(
+            build_file.read_text(encoding="utf-8").replace(
+                "dependencies {",
+                'dependencies {\nimplementation("com.example:escape-helper:1.0")',
+                1,
+            ),
+            encoding="utf-8",
+        )
+        self.assertIn("DEPENDENCY_BASELINE", self.rules())
+
+    def test_hidden_source_branch_is_still_a_writer_violation(self) -> None:
+        source = self.producer_source
+        source.write_text(
+            """
+            package com.opentypeless.routea.safety
+            internal class SafeProducer {
