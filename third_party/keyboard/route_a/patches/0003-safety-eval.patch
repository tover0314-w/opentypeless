+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ */
+
+package com.opentypeless.routea.safety
+
+/**
+ * Session-owned receiver between the physical/QuickAction dispatcher and one immutable route.
+ */
+class SafetyShellRouter(
+    private val writerRoute: ExclusiveWriterRoute,
+) : SafetyInputEventReceiver {
+    val sessionId: Long get() = writerRoute.sessionId
+
+    fun newInputEventDispatcher(): SafetyInputEventDispatcher =
+        SafetyInputEventDispatcher(this)
+
+    override fun onInput(intent: SafetyShellIntent): SafetyDispatchResult {
+        if (intent is SafetyShellIntent.QuickActionInsertKey
+            && intent.editorGeneration != writerRoute.sessionId
+        ) {
+            return SafetyDispatchResult.TargetChanged
+        }
+        val routedIntent = when (intent) {
+            is SafetyShellIntent.QuickActionInsertKey -> intent.toDirectIntent()
+            else -> intent
+        }
+        return writerRoute.dispatch(routedIntent)
+    }
+
+    private fun SafetyShellIntent.QuickActionInsertKey.toDirectIntent(): SafetyShellIntent =
+        when (key) {
+            SafetyShellIntent.QuickActionKey.VOICE -> SafetyShellIntent.Voice(editorGeneration)
+            SafetyShellIntent.QuickActionKey.UNDO -> SafetyShellIntent.Undo(editorGeneration)
+        }
+}
