index 0000000..ddefc63
--- /dev/null
+++ b/route-a-safety-eval/src/main/java/com/opentypeless/ksp004/RimeAdapter.java
@@ -0,0 +1,197 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2025 OpenTypeless Contributors
+
+package com.opentypeless.ksp004;
+
+import android.content.Context;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * Process-local, editor-capability-free JNI adapter for the pinned librime runtime.
+ *
+ * <p>The adapter returns bounded preedit/candidate data only. It never accepts or retains editor
+ * authority; candidate delivery remains owned by the OpenTypeless transaction host.
+ */
+public final class RimeAdapter implements AutoCloseable {
+    private static final String[] SCHEMA_FILES = {
+        "default.yaml", "ksp004.schema.yaml", "ksp004.dict.yaml"
+    };
+    private static final int MAX_ASCII_INPUT = 128;
+    private static final int MAX_RIME_TEXT_CODE_POINTS = 256;
+    private static final int MAX_RIME_TEXT_UTF16_UNITS = 512;
+
+    static {
+        System.loadLibrary("rime");
+        System.loadLibrary("opentypeless_rime");
+    }
+
+    private final File sharedDirectory;
+    private final File userDirectory;
+    private boolean closed;
+
+    private RimeAdapter(File sharedDirectory, File userDirectory) {
+        this.sharedDirectory = sharedDirectory;
+        this.userDirectory = userDirectory;
+    }
+
+    public static RimeAdapter open(Context context, File rootDirectory) throws IOException {
+        Objects.requireNonNull(context, "context");
+        Objects.requireNonNull(rootDirectory, "rootDirectory");
+        File shared = new File(rootDirectory, "shared");
+        File user = new File(rootDirectory, "user");
+        requireDirectory(shared);
+        requireDirectory(user);
+        installSchema(context, shared);
+        if (!nativeInitialize(shared.getCanonicalPath(), user.getCanonicalPath())) {
+            throw new IllegalStateException("Unable to initialize Rime");
+        }
+        RimeAdapter adapter = new RimeAdapter(shared, user);
+        try {
+            if (!nativeDeploy()) {
+                throw new IllegalStateException("Unable to deploy Rime schema");
+            }
+            return adapter;
+        } catch (RuntimeException failure) {
+            adapter.close();
+            throw failure;
+        }
+    }
+
+    public long createSession() {
+        requireOpen();
+        long session = nativeCreateSession();
+        if (session == 0L) {
+            throw new IllegalStateException("Unable to create Rime session");
+        }
+        return session;
+    }
+
+    public void destroySession(long session) {
+        requireOpen();
+        if (session == 0L || !nativeDestroySession(session)) {
+            throw new IllegalArgumentException("Unknown Rime session");
+        }
+    }
+
+    public Snapshot processAscii(long session, String input) {
+        requireOpen();
+        requireAsciiInput(input);
+        if (!nativeProcessAscii(session, input)) {
+            throw new IllegalStateException("Rime rejected bounded ASCII input");
+        }
+        String[] raw = nativeSnapshot(session);
+        if (raw == null || raw.length == 0 || raw.length > 17) {
+            throw new IllegalStateException("Rime returned an invalid snapshot");
+        }
+        String preedit = requireBoundedText(raw[0], "preedit");
+        ArrayList<String> candidates = new ArrayList<>(raw.length - 1);
+        for (int index = 1; index < raw.length; ++index) {
+            candidates.add(requireBoundedText(raw[index], "candidate"));
+        }
+        return new Snapshot(preedit, candidates);
+    }
+
+    public String selectCandidate(long session, int index) {
+        requireOpen();
+        if (index < 0 || index >= 16 || !nativeSelectCandidate(session, index)) {
+            throw new IllegalArgumentException("Invalid Rime candidate index");
+        }
+        return requireBoundedText(nativeTakeCommit(session), "commit");
+    }
+
+    @Override
+    public void close() {
+        if (!closed) {
+            closed = true;
+            nativeFinalizeEngine();
+        }
+    }
+
+    private void requireOpen() {
+        if (closed) throw new IllegalStateException("Rime adapter is closed");
+    }
+
+    private static String requireBoundedText(String value, String name) {
+        String safe = Objects.requireNonNull(value, name);
+        if (safe.length() > MAX_RIME_TEXT_UTF16_UNITS
+                || safe.codePointCount(0, safe.length()) > MAX_RIME_TEXT_CODE_POINTS) {
+            throw new IllegalStateException("Rime " + name + " exceeded the adapter limit");
+        }
+        return safe;
+    }
+
+    private static void requireAsciiInput(String input) {
+        Objects.requireNonNull(input, "input");
+        if (input.isEmpty() || input.length() > MAX_ASCII_INPUT) {
+            throw new IllegalArgumentException("Rime input length is outside the adapter limit");
+        }
+        for (int index = 0; index < input.length(); ++index) {
+            char value = input.charAt(index);
+            if (value < 'a' || value > 'z') {
+                throw new IllegalArgumentException("Rime test input must be lowercase ASCII");
+            }
+        }
+    }
+
+    private static void installSchema(Context context, File shared) throws IOException {
+        byte[] buffer = new byte[4096];
+        for (String name : SCHEMA_FILES) {
+            File destination = new File(shared, name);
+            try (InputStream source = context.getAssets().open("rime/" + name);
+                    FileOutputStream output = new FileOutputStream(destination, false)) {
+                int read;
+                while ((read = source.read(buffer)) != -1) {
+                    output.write(buffer, 0, read);
+                }
+            }
+        }
+    }
+
+    private static void requireDirectory(File directory) throws IOException {
+        if ((!directory.isDirectory() && !directory.mkdirs()) || !directory.isDirectory()) {
+            throw new IOException("Unable to create Rime data directory");
+        }
+    }
+
+    public static final class Snapshot {
+        private final String preedit;
+        private final List<String> candidates;
+
+        private Snapshot(String preedit, List<String> candidates) {
+            this.preedit = preedit;
+            this.candidates = Collections.unmodifiableList(new ArrayList<>(candidates));
+        }
+
+        public String preedit() {
+            return preedit;
+        }
+
+        public List<String> candidates() {
+            return candidates;
+        }
+
+        @Override
+        public String toString() {
+            return "Snapshot{preeditLength=" + preedit.length()
+                    + ", candidateCount=" + candidates.size() + '}';
+        }
+    }
+
+    private static native boolean nativeInitialize(String sharedDirectory, String userDirectory);
+    private static native boolean nativeDeploy();
+    private static native long nativeCreateSession();
+    private static native boolean nativeDestroySession(long session);
+    private static native boolean nativeProcessAscii(long session, String input);
+    private static native String[] nativeSnapshot(long session);
+    private static native boolean nativeSelectCandidate(long session, int index);
+    private static native String nativeTakeCommit(long session);
+    private static native void nativeFinalizeEngine();
+}
