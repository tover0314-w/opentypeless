+        )
+
+        assertEquals(10, intents.size)
+    }
+
+    @Test
+    fun textAndGenerationInputsAreBoundedBeforeDispatch() {
+        assertFailsWith<IllegalArgumentException> { SafetyShellIntent.Text("") }
+        assertFailsWith<IllegalArgumentException> {
+            SafetyShellIntent.Text("\uD83D\uDE00".repeat(257))
+        }
+        assertFailsWith<IllegalArgumentException> {
+            SafetyShellIntent.RimeKey('N', editorGeneration = 1L)
+        }
+        assertFailsWith<IllegalArgumentException> {
+            SafetyShellIntent.RimeCandidate("乙", editorGeneration = 0L)
+        }
+        assertFailsWith<IllegalArgumentException> {
+            SafetyShellIntent.Voice(editorGeneration = -1L)
+        }
+        assertFailsWith<IllegalArgumentException> {
+            SafetyShellIntent.QuickActionInsertText("", editorGeneration = 1L)
+        }
+        assertFailsWith<IllegalArgumentException> {
+            SafetyQuickAction.InsertText("")
+        }
+    }
+}
