+            SafetyDispatchResult.Accepted
+        }
+        val route = ExclusiveWriterRoute.bindForSession(
+            sessionId = 42L,
+            selectedRoute = SafetyWriterRoute.LEGACY,
+            safetySink = null,
+            legacyFakeSink = legacy,
+        )
+
+        assertSame(SafetyDispatchResult.Accepted, route.dispatch(SafetyShellIntent.Space))
+        assertEquals(1, legacyCalls)
+    }
+
+    @Test
+    fun missingOrDualBindingsFailBeforeAnyDispatch() {
+        var safetyCalls = 0
+        var legacyCalls = 0
+        val safety = SafetyEditorSink {
+            safetyCalls += 1
+            SafetyDispatchResult.Accepted
+        }
+        val legacy = LegacyEvaluationSink {
+            legacyCalls += 1
+            SafetyDispatchResult.Accepted
+        }
+
+        assertFailsWith<IllegalArgumentException> {
+            ExclusiveWriterRoute.bindForSession(1L, SafetyWriterRoute.SAFETY, null, null)
+        }
+        assertFailsWith<IllegalArgumentException> {
+            ExclusiveWriterRoute.bindForSession(1L, SafetyWriterRoute.LEGACY, null, null)
+        }
+        assertFailsWith<IllegalArgumentException> {
+            ExclusiveWriterRoute.bindForSession(1L, SafetyWriterRoute.SAFETY, safety, legacy)
+        }
+        assertFailsWith<IllegalArgumentException> {
+            ExclusiveWriterRoute.bindForSession(1L, SafetyWriterRoute.LEGACY, safety, legacy)
