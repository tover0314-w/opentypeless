diff --git a/opentypeless-editor-host/src/main/java/com/opentypeless/android/editor/TextFingerprint.java b/opentypeless-editor-host/src/main/java/com/opentypeless/android/editor/TextFingerprint.java
new file mode 100644
index 0000000000000000000000000000000000000000..a4f5ac700de25d445739f8dfb8e2112802d72498
