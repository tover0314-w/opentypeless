+
+    @FunctionalInterface
+    interface CleanupSink {
+        void record(CleanupFailure failure);
+    }
+
+    /** Receives one content-free observation for each transaction that reaches a stable result. */
+    @FunctionalInterface
+    interface AuditSink {
