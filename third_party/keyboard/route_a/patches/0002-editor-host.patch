+
+package com.opentypeless.android.editor.host;
+
+import android.inputmethodservice.InputMethodService;
+import android.view.inputmethod.EditorInfo;
+import android.view.inputmethod.InputConnection;
+
+/**
+ * Final lifecycle bridge which confines Android editor authority to the editor-host module.
+ *
+ * <p>Subclasses can create UI and receive capability-free lifecycle hooks, but cannot override the
+ * editor lifecycle or obtain the manager, registry or framework connection.
+ */
+public abstract class EditorAuthorityInputMethodService extends InputMethodService {
+    private final EditorSessionManager manager = new EditorSessionManager();
+    private final EditorSessionManager.KeyboardHost keyboardHost =
+            new EditorSessionManager.KeyboardHost() {
+                @Override
+                public EditorInfo currentEditorInfo() {
+                    return getCurrentInputEditorInfo();
+                }
+
+                @Override
+                public InputConnection currentInputConnection() {
+                    return getCurrentInputConnection();
+                }
+            };
+    private final EditorPort port = new EditorPort(manager, keyboardHost);
+    private boolean destroyed;
+
+    protected final EditorPort editorPort() {
+        if (destroyed) throw new IllegalStateException("IME service is destroyed");
+        return port;
+    }
+
+    @Override
+    public final void onStartInput(EditorInfo attribute, boolean restarting) {
+        super.onStartInput(attribute, restarting);
+        manager.onStartInput(attribute, getCurrentInputConnection());
+        port.onStartInput();
+        onEditorInputStarted(attribute, restarting, port.generation());
+    }
+
+    @Override
+    public final void onUpdateSelection(
+            int oldSelStart,
+            int oldSelEnd,
+            int newSelStart,
+            int newSelEnd,
+            int candidatesStart,
+            int candidatesEnd) {
+        super.onUpdateSelection(
+                oldSelStart, oldSelEnd, newSelStart, newSelEnd, candidatesStart, candidatesEnd);
+        manager.onSelectionChanged(newSelStart, newSelEnd);
+        onEditorSelectionChanged(newSelStart, newSelEnd);
+    }
+
+    @Override
+    public final void onFinishInput() {
+        onEditorInputFinishing();
+        port.onFinishInput();
+        manager.onFinishInput();
+        super.onFinishInput();
+    }
+
+    @Override
+    public final void onDestroy() {
+        if (!destroyed) {
+            destroyed = true;
+            onEditorAuthorityDestroying();
+            port.close();
+            manager.close();
+        }
+        super.onDestroy();
+    }
+
+    protected void onEditorInputStarted(
+            EditorInfo editorInfo, boolean restarting, long generation) {}
+
+    protected void onEditorSelectionChanged(int start, int end) {}
+
+    protected void onEditorInputFinishing() {}
+
+    protected void onEditorAuthorityDestroying() {}
+}
diff --git a/opentypeless-editor-host/src/main/java/com/opentypeless/android/editor/host/EditorPort.java b/opentypeless-editor-host/src/main/java/com/opentypeless/android/editor/host/EditorPort.java
new file mode 100644
index 0000000000000000000000000000000000000000..9ac491437328c9fa04838e4097ed65606ffa43eb
--- /dev/null
+++ b/opentypeless-editor-host/src/main/java/com/opentypeless/android/editor/host/EditorPort.java
@@ -0,0 +1,308 @@
+/*
+ * Copyright (C) 2026 OpenTypeless Contributors
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ */
+
+package com.opentypeless.android.editor.host;
+
+import com.opentypeless.android.editor.CommitRecord;
+import com.opentypeless.android.editor.EditorSessionSnapshot;
+import com.opentypeless.android.editor.EditorTransactionResult;
+import com.opentypeless.android.editor.RejectionReason;
+import com.opentypeless.android.editor.TargetChangeReason;
+import com.opentypeless.android.editor.TransactionReceipt;
+import java.util.Objects;
+
+/**
+ * Capability-free Shell port owned by the Android editor-authority enclave.
+ *
+ * <p>The port exposes bounded domain operations only. It contains no Android editor capability,
+ * and producers cannot obtain the manager, registry or framework connection from it.
+ */
+public final class EditorPort {
+    public enum VoiceStage {
+        PARTIAL_ONE,
+        PARTIAL_TWO,
+        FINAL,
+        UNDO,
+        REJECTED
+    }
+
+    public record VoiceOutcome(VoiceStage stage, EditorTransactionResult result) {
+        public VoiceOutcome {
+            Objects.requireNonNull(stage, "stage");
+            Objects.requireNonNull(result, "result");
+        }
+
+        @Override
+        public String toString() {
+            return "VoiceOutcome{stage=" + stage
+                    + ",result=" + result.getClass().getSimpleName()
+                    + ",details=<redacted>}";
+        }
+    }
+
+    private static final String PARTIAL_ONE = "vo";
+    private static final String PARTIAL_TWO = "voice";
+    private static final String RAW_TRANSCRIPT = "voice raw";
+
+    private final EditorSessionManager manager;
+    private final EditorSessionManager.KeyboardHost host;
+    private long generation;
+    private boolean generationExhausted;
+    private EditorSessionSnapshot voiceExpected;
+    private long voiceRevision;
+    private String voiceCommitId;
+    private EditorSessionManager.RimeTargetLease rimeTarget;
+    private boolean closed;
+
+    EditorPort(
+            EditorSessionManager manager,
+            EditorSessionManager.KeyboardHost host) {
+        this.manager = Objects.requireNonNull(manager, "manager");
+        this.host = Objects.requireNonNull(host, "host");
+    }
+
+    public long generation() {
+        requireOpen();
+        return generation;
+    }
+
+    public boolean isCurrentGeneration(long expectedGeneration) {
+        requireOpen();
+        return !generationExhausted && generation == expectedGeneration;
+    }
+
+    /**
+     * Returns whether plaintext-producing features may run for the current exact editor target.
+     *
+     * <p>Unavailable evidence is treated like a sensitive field. The immutable snapshot remains
+     * inside the authority enclave and no text or editor capability crosses this method.
+     */
+    public boolean allowsPlaintextProcessing() {
+        requireOpen();
+        return manager.assistiveProcessingAllowed(host);
+    }
+
+    /** Returns whether ordinary local keyboard input may be exposed for this editor. */
+    public boolean allowsKeyboardProcessing() {
+        requireOpen();
+        return manager.keyboardProcessingAllowed(host);
+    }
+
+    /** Returns whether the current target permits a learning-capable Rime session. */
+    public boolean allowsRimeProcessing() {
+        requireOpen();
+        return manager.rimeProcessingAllowed(host);
+    }
+
+    public EditorTransactionResult insertLatin(String text) {
+        requireOpen();
+        EditorSessionSnapshot expected = capture();
+        return expected == null
+                ? unavailable()
+                : manager.insertKeyboardText(host, expected, text);
+    }
+
+    public EditorTransactionResult insertRime(long expectedGeneration, String text) {
+        requireOpen();
+        EditorSessionManager.RimeTargetLease target = rimeTarget;
+        if (!isCurrentGeneration(expectedGeneration) || target == null) {
+            return new EditorTransactionResult.TargetChanged(TargetChangeReason.SESSION_REVOKED);
+        }
+        rimeTarget = null;
+        return manager.insertRimeText(host, target, text);
+    }
+
+    /** Captures once, then validates the same target before every queued Rime command. */
+    public boolean prepareRimeTarget(long expectedGeneration) {
+        requireOpen();
+        if (!isCurrentGeneration(expectedGeneration)) return false;
+        if (rimeTarget == null) {
+            rimeTarget = manager.captureRimeTarget(host);
+            return rimeTarget != null;
+        }
+        if (!manager.rimeProcessingAllowed(host)
+                || !manager.rimeTargetStillCurrent(rimeTarget)) {
+            rimeTarget = null;
+            return false;
+        }
+        return true;
+    }
+
+    /** Revalidates an already-frozen Rime target without capturing the current cursor. */
+    public boolean rimeTargetStillCurrent(long expectedGeneration) {
+        requireOpen();
+        return isCurrentGeneration(expectedGeneration)
+                && rimeTarget != null
+                && manager.rimeProcessingAllowed(host)
+                && manager.rimeTargetStillCurrent(rimeTarget);
+    }
+
+    /** Revokes a frozen Rime target; returns whether an active target was discarded. */
+    public boolean cancelRimeTarget(long expectedGeneration) {
+        requireOpen();
+        if (!isCurrentGeneration(expectedGeneration)) return false;
+        boolean existed = rimeTarget != null;
+        rimeTarget = null;
+        return existed;
+    }
+
+    public EditorTransactionResult insertAction(String text) {
+        requireOpen();
+        EditorSessionSnapshot expected = capture();
+        return expected == null
+                ? unavailable()
+                : manager.insertActionText(host, expected, text);
+    }
+
+    public EditorTransactionResult deleteBackward() {
+        requireOpen();
+        EditorSessionSnapshot expected = capture();
+        return expected == null
+                ? unavailable()
+                : manager.deleteKeyboardBackward(host, expected);
+    }
+
+    public EditorTransactionResult performEnter() {
+        requireOpen();
+        EditorSessionSnapshot expected = capture();
+        return expected == null
+                ? unavailable()
+                : manager.performKeyboardEnter(host, expected);
+    }
+
+    /** Advances Voice partial-one, partial-two and final; Undo remains a separate user action. */
+    public VoiceOutcome advanceVoice() {
+        requireOpen();
+        if (voiceCommitId != null) return rejectedVoice();
+        if (voiceExpected == null) return startVoice();
+        if (voiceRevision == 1L) return updateVoice();
+        if (voiceRevision == 2L) return commitVoice();
+        return rejectedVoice();
+    }
+
+    /** Applies the exact-ID Undo only after a successful final in this input generation. */
+    public VoiceOutcome undoVoice() {
+        requireOpen();
+        if (voiceCommitId == null) return rejectedVoice();
+        EditorSessionSnapshot expected = capture();
+        if (expected == null) return rejectedVoice();
+        EditorTransactionResult result = manager.undoVoiceCommit(host, expected, voiceCommitId);
+        resetVoice();
+        return new VoiceOutcome(
+                result instanceof EditorTransactionResult.Applied
+                        ? VoiceStage.UNDO : VoiceStage.REJECTED,
+                result);
+    }
+
+    void onStartInput() {
+        requireOpen();
+        advanceGeneration();
+        rimeTarget = null;
+        resetVoice();
+    }
+
+    void onFinishInput() {
+        requireOpen();
+        advanceGeneration();
+        rimeTarget = null;
+        resetVoice();
+    }
+
+    void close() {
+        if (closed) return;
+        closed = true;
+        rimeTarget = null;
+        resetVoice();
+    }
+
+    private VoiceOutcome startVoice() {
+        EditorSessionSnapshot expected = capture();
+        if (expected == null) return rejectedVoice();
+        EditorTransactionResult result = manager.setVoiceComposition(
+                host, expected, PARTIAL_ONE, 1L);
+        if (result instanceof EditorTransactionResult.Applied) {
+            voiceExpected = capture();
+            voiceRevision = voiceExpected == null ? 0L : 1L;
+        }
+        if (voiceExpected == null) resetVoice();
+        return voiceOutcome(VoiceStage.PARTIAL_ONE, result);
+    }
+
+    private VoiceOutcome updateVoice() {
+        EditorTransactionResult result = manager.setVoiceComposition(
+                host, voiceExpected, PARTIAL_TWO, 2L);
+        if (result instanceof EditorTransactionResult.Applied) {
+            voiceExpected = capture();
+            voiceRevision = voiceExpected == null ? 0L : 2L;
+        }
+        if (voiceExpected == null) resetVoice();
+        return voiceOutcome(VoiceStage.PARTIAL_TWO, result);
+    }
+
+    private VoiceOutcome commitVoice() {
+        TransactionReceipt receipt = manager.commitVoiceComposition(
+                host,
+                voiceExpected,
+                voiceRevision,
+                new CommitRecord.RawTranscript.Present(RAW_TRANSCRIPT));
+        EditorTransactionResult result = receipt.result();
+        if (receipt instanceof TransactionReceipt.Committed committed) {
+            voiceCommitId = committed.record().commitId();
+            voiceExpected = null;
+            voiceRevision = 0L;
+        } else {
+            resetVoice();
+        }
+        return voiceOutcome(VoiceStage.FINAL, result);
+    }
+
+    private VoiceOutcome voiceOutcome(VoiceStage requested, EditorTransactionResult result) {
+        return new VoiceOutcome(
+                result instanceof EditorTransactionResult.Applied
+                        ? requested : VoiceStage.REJECTED,
+                result);
+    }
+
+    private VoiceOutcome rejectedVoice() {
+        return new VoiceOutcome(
+                VoiceStage.REJECTED,
+                new EditorTransactionResult.Rejected(RejectionReason.POLICY_DENIED));
+    }
+
+    private EditorSessionSnapshot capture() {
+        EditorSessionManager.CaptureResult capture = manager.captureKeyboardSnapshot(host);
+        return capture instanceof EditorSessionManager.Captured captured
+                ? captured.snapshot() : null;
+    }
+
+    private EditorTransactionResult unavailable() {
+        return new EditorTransactionResult.TargetChanged(TargetChangeReason.EVIDENCE_UNAVAILABLE);
+    }
+
+    private void resetVoice() {
+        voiceExpected = null;
+        voiceRevision = 0L;
+        voiceCommitId = null;
+    }
+
+    private void advanceGeneration() {
+        if (generation == Long.MAX_VALUE) {
+            generationExhausted = true;
+            return;
+        }
+        generation += 1L;
+    }
+
+    private void requireOpen() {
+        if (closed) throw new IllegalStateException("EditorPort is closed");
+    }
+
+    @Override
+    public String toString() {
+        return "EditorPort{generation=" + generation + ",details=<redacted>}";
+    }
+}
